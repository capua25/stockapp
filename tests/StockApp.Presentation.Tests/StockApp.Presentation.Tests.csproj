<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <!-- Para abrir y validar el PDF real que genera PdfExporterMigraDoc en
         Exportacion/ColumnasPdfContraDtosRealesTests.cs (misma técnica que
         StockApp.Documentos.Tests, ver docs/superpowers/decisions/2026-09-18-spike-pdf-imagenes-y-assert.md). -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo referenciamos Application (interfaces de servicios) y Presentation (ViewModels) -->
    <ProjectReference Include="..\..\src\StockApp.Application\StockApp.Application.csproj" />
    <ProjectReference Include="..\..\src\StockApp.Presentation\StockApp.Presentation.csproj" />
  </ItemGroup>

</Project>
