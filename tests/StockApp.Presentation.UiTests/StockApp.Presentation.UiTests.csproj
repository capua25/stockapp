<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Banco de pruebas headless para reproducir/verificar el bug de sort por click de
         encabezado en Avalonia.Controls.DataGrid (AvaloniaUI/Avalonia.Controls.DataGrid#232,
         transferido desde avaloniaui/avalonia#21129). Ver DataGridSortClickTests.cs. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Version del DataGrid a validar: se pisa manualmente durante la investigación
         (12.0.0 = reproduce el bug; 12.0.1 = fix upstream confirmado). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- Avalonia.Headless.XUnit 12.0.4 depende de xunit.v3.extensibility.core (xunit v3),
         no de xunit v2 clasico: hay que usar el paquete xunit.v3 + un runner v3-compatible,
         si no [AvaloniaFact] no es reconocido y "dotnet test" reporta 0 tests sin error.
         VersionOverride puntual: este proyecto es el único que corre sobre xunit v3, el
         resto de la suite usa xunit v2 (versión central en Directory.Packages.props). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="17.12.0" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenciados para MovimientoFormControlValidacionTests.cs: reproduce con la vista y
         el tema REALES el bug de InvalidCastException al vaciar "Precio unitario" y verifica
         la política de DataValidationErrors.ErrorConverter en Themes/Controls.axaml. -->
    <ProjectReference Include="..\..\src\StockApp.Application\StockApp.Application.csproj" />
    <ProjectReference Include="..\..\src\StockApp.Presentation\StockApp.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- bugfix/backups-endpoint-tests-flaky: helper de sondeo con reloj monotónico, compartido
         por los 4 proyectos de test que esperan una condición observable sin Task expuesta.
         Mismo mecanismo de Link que las fixtures .ods de StockApp.Api.Tests, aplicado a un
         Compile item: no hay proyecto TestSupport nuevo, el archivo físico vive en
         tests\_Compartido\. -->
    <Compile Include="..\_Compartido\EsperaMonotonica.cs">
      <Link>Compartido\EsperaMonotonica.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
