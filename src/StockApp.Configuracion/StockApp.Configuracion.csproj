<Project Sdk="Microsoft.NET.Sdk">

  <!-- Librería mínima y SIN dependencias de paquetes (solo BCL): la ruta del archivo de
       conexión y la lógica de leer/escribir la necesitan DOS ejecutables distintos
       (StockApp.Presentation, que lee, y tools/StockApp.Configurador, que escribe). Un solo
       lugar de verdad evita que la ruta o la clave "Api:BaseUrl" queden duplicadas en dos
       binarios sin nada que las ate (ver 2026-08-20-configurador-conexion). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StockApp.Configuracion.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Bug 2026-09-18 (Configurador no lee appsettings.json): la resolución de precedencia
       conexion.json -> appsettings.json -> ConexionDefaults.UrlPorDefecto se centraliza acá
       (ResolucionConexion) para que App.axaml.cs (StockApp.Presentation) y
       tools/StockApp.Configurador consuman EXACTAMENTE la misma función. Antes vivía
       duplicada: la app armaba un IConfiguration real con dos capas, el Configurador se
       salteaba appsettings.json por completo. Versiones en Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

</Project>
