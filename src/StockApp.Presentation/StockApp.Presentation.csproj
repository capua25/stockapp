<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Branding visible al usuario final: el producto pasa a llamarse "Gestión Municipal".
         RootNamespace se fija explícito para que el default no siga a AssemblyName y
         rompa los x:Class="StockApp.Presentation.Views...." de todas las vistas. -->
    <RootNamespace>StockApp.Presentation</RootNamespace>
    <AssemblyName>GestionMunicipal</AssemblyName>
    <Product>Gestión Municipal</Product>
    <!-- Versionado: single source of truth. Editar SOLO acá antes de empaquetar.
         Los scripts build/pack-win.ps1 y build/pack-linux.sh leen este valor
         y lo pasan a `vpk pack (parametro packVersion)`. -->
    <Version>0.2.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StockApp.Presentation.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia.Controls.DataGrid 12.0.1 fixea AvaloniaUI/Avalonia.Controls.DataGrid#232
         (sort por click de header roto con compiled bindings, ver DataGridColumn.GetSortPropertyName
         chequeando CompiledBindingExtension en vez de CompiledBinding). 12.0.1 exige
         Avalonia >= 12.0.5 como dependencia transitiva, por eso el resto de los paquetes
         de Avalonia core suben en conjunto a 12.0.5. Verificado con banco de pruebas headless
         en tests/StockApp.Presentation.UiTests (click real de puntero sobre el header). -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Velopack" />
    <!-- Iconos consistentes en sidebar y botones clave (Tarea 3, UI Kit).
         Verificado en nuget.org 2026-07-04: Optris.Icons.Avalonia 12.0.7 depende de
         "Avalonia >= 12.0.1" (compatible con nuestro 12.0.4) y soporta net10.0.
         Si pasó tiempo desde que se escribió este plan, correr primero
         "dotnet list package /outdated" en este proyecto para confirmar que 12.0.7
         sigue siendo la última estable antes de fijar la versión. -->
    <PackageReference Include="Optris.Icons.Avalonia" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockApp.ApiClient\StockApp.ApiClient.csproj" />
    <ProjectReference Include="..\StockApp.Application\StockApp.Application.csproj" />
  </ItemGroup>
</Project>
