<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════════
         StockApp UI Kit — Tokens de color.
         Único lugar de verdad de la paleta. Typography.axaml, Controls.axaml
         y las vistas referencian estos recursos vía DynamicResource, nunca
         hex hardcodeado. Ver docs/superpowers/specs/2026-07-04-ui-uplift-design.md.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Escala de espaciado, base 4 ────────────────────────────────────────
         Spacing de StackPanel es double; Margin y Padding son Thickness. Por eso
         hay dos familias: los doubles son la escala, y abajo van los Thickness
         derivados que se repiten. Un Thickness asimetrico puntual (p. ej.
         "0,8,0,0") se sigue escribiendo inline. -->
    <x:Double x:Key="Espacio1">4</x:Double>
    <x:Double x:Key="Espacio2">8</x:Double>
    <x:Double x:Key="Espacio3">12</x:Double>
    <x:Double x:Key="Espacio4">16</x:Double>
    <x:Double x:Key="Espacio5">24</x:Double>

    <!-- Margen exterior estandar de TODA vista (Espacio5). Hoy van de 16 a 40
         segun el archivo y NuevaImportacionView.axaml no tiene ninguno. -->
    <Thickness x:Key="MargenVista">24</Thickness>
    <Thickness x:Key="PaddingCard">16</Thickness>
    <!-- Padding de celda y header de DataGrid: 12,8 con 4 a la derecha (no 12). Con 12, el
         texto que no entra en la columna se cortaba 12 px antes del borde y quedaba un hueco
         ("Prueba U…" + espacio vacío). Ver Themes/DataGrid.axaml y GrillasEspacioDerechoBarridoTests. -->
    <Thickness x:Key="PaddingCeldaGrilla">12,8,4,8</Thickness>

    <!-- ── Radios ──────────────────────────────────────────────────────────
         Base para botones e inputs, card para contenedores. -->
    <CornerRadius x:Key="RadioBase">6</CornerRadius>
    <CornerRadius x:Key="RadioCard">10</CornerRadius>

    <!-- ── Sombras ───────────────────────────────────────────────────────── -->
    <BoxShadows x:Key="SombraCard">0 1 3 0 #1A0F172A</BoxShadows>

    <!-- Texto terciario: reemplaza los 60 usos de Opacity="0.5|0.6|0.7".
         El color se DECLARA, no se atenua — asi el contraste es medible y
         testeable, en vez de depender de sobre que fondo cayo la opacidad. -->
    <!-- Escala de grises de texto (Primario/Secundario/Terciario, ver mas abajo): los tres
         niveles estan calibrados para pasar WCAG AA (>= 4.5:1) contra ColorSuperficie Y
         ColorFondo. El ORDEN RELATIVO entre ellos es parte del contrato: primario mas
         oscuro que secundario, secundario mas oscuro que terciario. No muevas un solo
         nivel sin revisar los otros dos, o la jerarquia se invierte (ver
         EscalaTextoContrasteTests). El terciario tiene apenas 1.4% de margen sobre el
         piso de ColorFondo: no hay un gris valido perceptiblemente mas claro. -->
    <Color x:Key="ColorTextoTerciario">#64748B</Color>

    <!-- ── Colores base ─────────────────────────────────────────────────── -->
    <Color x:Key="ColorBrand">#16A34A</Color>
    <Color x:Key="ColorBrandHover">#15803D</Color>
    <Color x:Key="ColorBrandPressed">#166534</Color>
    <Color x:Key="ColorBrandSuave">#DCFCE7</Color>

    <Color x:Key="ColorFondo">#F8FAFC</Color>
    <Color x:Key="ColorSuperficie">#FFFFFF</Color>
    <Color x:Key="ColorBorde">#E2E8F0</Color>

    <Color x:Key="ColorTextoPrimario">#0F172A</Color>
    <Color x:Key="ColorTextoSecundario">#475569</Color>

    <Color x:Key="ColorWarning">#D97706</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>


    <!-- Estado deshabilitado: derivados neutros, necesarios para los estados
         :disabled de Controls.axaml (Tarea 2). No forman parte de la paleta
         semántica pedida en la spec pero son indispensables para que los
         botones/inputs deshabilitados no se vean rotos. -->
    <Color x:Key="ColorDeshabilitadoFondo">#F1F5F9</Color>
    <Color x:Key="ColorDeshabilitadoTexto">#94A3B8</Color>
    <Color x:Key="ColorDeshabilitadoBorde">#E2E8F0</Color>

    <!-- ColorSidebar / SidebarBrush: tono oscuro que usa Button.primary:pressed (ver
         Controls.axaml). El sidebar de la app es v2 y tiene sus propios tokens. -->
    <Color x:Key="ColorSidebar">#1E293B</Color>
    <!-- Overlays translúcidos para hover/pressed de ítems ghost sobre el
         fondo oscuro del sidebar (no hay Deshabilitado*/BrandSuave que sirvan
         sobre fondo oscuro). -->

    <!-- Overlays translúcidos para hover/pressed de Button.ghost sobre fondo
         CLARO: base oscura (ColorTextoPrimario) con opacidad 0x22/0x33, para que
         el overlay oscurezca un fondo blanco/Superficie. -->
    <Color x:Key="ColorGhostHoverOverlay">#220F172A</Color>
    <Color x:Key="ColorGhostPressedOverlay">#330F172A</Color>

    <!-- ── Brushes (lo que efectivamente se referencia desde XAML) ────────── -->
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource ColorBrand}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource ColorBrandHover}" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="{StaticResource ColorBrandPressed}" />
    <SolidColorBrush x:Key="BrandSuaveBrush" Color="{StaticResource ColorBrandSuave}" />

    <SolidColorBrush x:Key="FondoBrush" Color="{StaticResource ColorFondo}" />
    <SolidColorBrush x:Key="SuperficieBrush" Color="{StaticResource ColorSuperficie}" />
    <SolidColorBrush x:Key="BordeBrush" Color="{StaticResource ColorBorde}" />

    <SolidColorBrush x:Key="TextoPrimarioBrush" Color="{StaticResource ColorTextoPrimario}" />
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="{StaticResource ColorTextoSecundario}" />
    <SolidColorBrush x:Key="TextoTerciarioBrush" Color="{StaticResource ColorTextoTerciario}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />

    <SolidColorBrush x:Key="DeshabilitadoFondoBrush" Color="{StaticResource ColorDeshabilitadoFondo}" />
    <SolidColorBrush x:Key="DeshabilitadoTextoBrush" Color="{StaticResource ColorDeshabilitadoTexto}" />
    <SolidColorBrush x:Key="DeshabilitadoBordeBrush" Color="{StaticResource ColorDeshabilitadoBorde}" />

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}" />

    <SolidColorBrush x:Key="GhostHoverOverlayBrush" Color="{StaticResource ColorGhostHoverOverlay}" />
    <SolidColorBrush x:Key="GhostPressedOverlayBrush" Color="{StaticResource ColorGhostPressedOverlay}" />

</ResourceDictionary>
