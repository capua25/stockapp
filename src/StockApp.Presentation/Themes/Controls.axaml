<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:StockApp.Presentation.Converters"
        xmlns:beh="using:StockApp.Presentation.Behaviors">

    <!-- ════════════════════════════════════════════════════════════════════
         StockApp UI Kit — Controles globales.
         Aditivo sobre FluentTheme: los estilos de Button de acá abajo SOLO
         aplican a controles con clase explícita (Button.primary, Button.
         secondary, Button.ghost, Border.card). Un Button sin
         clase sigue viéndose con el FluentTheme default. TextBox/ComboBox
         SÍ son globales (sin clase requerida): ver Deliverable de la Tarea 2.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Button (global, sin clase requerida) ─────────────────────────────
         Default limpio para botones sin Classes explícitas: evita el gris
         feo de FluentTheme. Los selectores .primary/.secondary/.ghost
         de abajo tienen mayor especificidad (selector con clase) y ganan
         sobre este default sin importar el orden de declaración. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="16,8" />
        <!-- Integridad de datos (bug 2026-10-01): un botón cuyo Command es un comando de guardado
             (ViewModelBase.ComandoDeGuardado) explica por qué está deshabilitado mientras hay un
             campo en rojo. Ver ErroresDeEntradaBehavior.ExplicarBloqueo. -->
        <Setter Property="(beh:ErroresDeEntradaBehavior.ExplicarBloqueo)" Value="True" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandSuaveBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource DeshabilitadoFondoBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DeshabilitadoTextoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DeshabilitadoBordeBrush}" />
    </Style>

    <!-- ── Button: primary (acción principal) ──────────────────────────────
         Background usa BrandHoverBrush (#15803D), NO BrandBrush (#16A34A):
         blanco sobre #16A34A da ~3.9:1 (insuficiente para AA), sobre #15803D
         da ~5.9:1. Pressed usa SidebarBrush (#14532D, mismo tono que el
         fondo del sidebar) como tercer escalón, más oscuro que BrandPressedBrush. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource DeshabilitadoFondoBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DeshabilitadoTextoBrush}" />
    </Style>

    <!-- ── Button: secondary (outline) ─────────────────────────────────────
         Foreground/BorderBrush usan BrandHoverBrush (#15803D), no BrandBrush,
         por el mismo motivo de contraste que .primary (texto sobre Superficie). -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandSuaveBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource BrandSuaveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPressedBrush}" />
    </Style>
    <Style Selector="Button.secondary:disabled">
        <Setter Property="Foreground" Value="{DynamicResource DeshabilitadoTextoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DeshabilitadoBordeBrush}" />
    </Style>

    <!-- ── Button: ghost (neutro, fondo claro) ──────────────────────────────
         Variante DEFAULT, pensada para fondo claro (Border.card / Superficie
         blanca). Hasta acá .ghost estaba diseñado EXCLUSIVAMENTE para el
         sidebar (fondo verde bosque oscuro) con texto blanco: ese mismo
         estilo se reusó sobre fondo claro (DocumentoListView, TareaListView,
         InicioView, NuevaImportacionView) y dio texto blanco sobre blanco:
         contraste 1:1, botones invisibles aunque clickeables. Ahora
         Button.ghost es la variante neutra (texto TextoPrimarioBrush, hover/
         pressed con overlay OSCURO translúcido). La variante de sidebar ya no
         existe: el sidebar v2 tiene sus propios estilos. -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource GhostHoverOverlayBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="Background" Value="{DynamicResource GhostPressedOverlayBrush}" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Foreground" Value="{DynamicResource DeshabilitadoTextoBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ── TextBox (global, sin clase requerida) ────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        <!-- Política: ninguna excepción cruda de .NET (p. ej. InvalidCastException/FormatException
             de un binding TwoWay que falla al convertir texto a un número) debe llegar a la UI.
             DataValidationErrors.ErrorConverter transforma cada error ANTES de que quede expuesto
             en DataValidationErrors.Errors (ver ErrorValidacionConverter.cs), así que blindar acá
             una sola vez alcanza para TODO TextBox de la app, sin tocar el ErrorTemplate ni el
             Template (dónde/cómo se ve el error queda igual al default de FluentTheme). -->
        <Setter Property="(DataValidationErrors.ErrorConverter)" Value="{x:Static conv:ErrorValidacionConverter.Instance}" />
        <!-- Integridad de datos (bug 2026-10-01): un texto que el converter rechaza (ej. "5.4") NO
             llega al ViewModel, que conserva el valor anterior. Cada TextBox avisa su error al
             ViewModel de la pantalla (ViewModelBase.HayErroresDeEntrada) para que Guardar/
             Confirmar se deshabilite mientras haya un campo en rojo. Ver ErroresDeEntradaBehavior.cs. -->
        <Setter Property="(beh:ErroresDeEntradaBehavior.Reportar)" Value="True" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ── NumericUpDown (global, sin clase requerida) ──────────────────────────
         ShowButtonSpinner="False" en TODA la app: el usuario reportó las flechitas
         arriba/abajo como ruido visual en cada campo numérico (ej. "Producto ID").
         Sin este Style, NumericUpDown queda con el default crudo de FluentTheme
         (Background semitransparente #66ffffff, BorderBrush #99000000, Padding
         asimétrico 10,6,6,5, CornerRadius 3) que NO combina con el TextBox
         themeado de acá arriba — se ve como un control totalmente distinto. Mismos
         tokens que TextBox (Background/BorderBrush/CornerRadius/Padding) para que,
         sin flechitas, un NumericUpDown sea visualmente indistinguible de un campo
         de texto común. El Padding del NumericUpDown se propaga por TemplateBinding
         al TextBox interno (PART_TextBox), así que definirlo acá alcanza para que
         el texto quede alineado igual que en un TextBox — no hace falta tocar el
         template. Verificado (headless): al ocultar el spinner el TextBox interno
         ya se estira solo para ocupar el ancho completo, sin dejar hueco. -->
    <Style Selector="NumericUpDown">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}" />
        <!-- Integridad de datos (bug 2026-10-01): un texto inválido ("20a5", un año fuera de
             Minimum/Maximum) no llega al ViewModel y NumericUpDown no marcaba nada; al perder el
             foco volvía en silencio al valor anterior. NumericUpDownValidacionBehavior marca el
             error y retiene el texto; Reportar lo publica para bloquear Guardar/Buscar. -->
        <Setter Property="(beh:NumericUpDownValidacionBehavior.Validar)" Value="True" />
        <Setter Property="(beh:ErroresDeEntradaBehavior.Reportar)" Value="True" />
    </Style>

    <!-- ── ComboBox (global, sin clase requerida) ───────────────────────────── -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioBase}" />
        <Setter Property="Padding" Value="10,8" />
        <!-- Misma política que TextBox: ver comentario de arriba. -->
        <Setter Property="(DataValidationErrors.ErrorConverter)" Value="{x:Static conv:ErrorValidacionConverter.Instance}" />
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ── Card (Border) ────────────────────────────────────────────────────── -->
    <!-- Card blanca "flotando" sobre el fondo claro del área de contenido:
         borde NEUTRO sutil (BordeBrush), no verde — el acento de la vista lo
         da el contenido/título (titulo-vista), no el borde de la card.
         BoxShadow suave es lo que la despega del fondo. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioCard}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
        <Setter Property="BoxShadow" Value="{DynamicResource SombraCard}" />
    </Style>

</Styles>
