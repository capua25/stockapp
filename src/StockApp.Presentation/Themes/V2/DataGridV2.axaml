<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:StockApp.Presentation.Behaviors">

    <!-- UI v2 (spec 2026-09-28 §3.3): tema de DataGrid, SOLO dentro de .ui2. Se incluye al final
         de App.axaml. Themes/DataGrid.axaml (viejo) sigue aplicando y NO se repite acá lo que se
         conserva: CanUserResizeColumns, MinColumnWidth 40 (fix 3548397 de MinWidth por columna y
         scroll horizontal) y el apagado del recuadro de foco de celda.
         Geometría MEDIDA en Avalonia.Controls.DataGrid 12.0.1: la fila mide RowHeight + 1 de
         PART_BottomGridLine; el header mide ColumnHeaderHeight con el separador de 1 adentro. Por eso
         RowHeight es 39 (pitch 40 = V2AltoFilaGrilla) y ColumnHeaderHeight es el token (36).
         Custodiado por UiTests/V2/DataGridV2Tests. -->

    <Style Selector=".ui2 DataGrid">
        <Setter Property="RowHeight" Value="39" />
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource V2AltoHeaderGrilla}" />
        <Setter Property="Background" Value="{DynamicResource V2SuperficieBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2SeparadorGrillaBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadioControl}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource V2SeparadorGrillaBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource V2FuenteControlTamano}" />
        <Setter Property="Foreground" Value="{DynamicResource V2TextoEtiquetaBrush}" />
    </Style>

    <!-- Esquinas redondeadas también para el contenido: el Grid interno de Fluent recorta a su
         rectángulo, no al radio, y el separador de la última fila llegaba recto hasta el borde
         (medido en el catálogo, Task 17). El Border con ClipToBounds recorta al CornerRadius,
         como overflow: hidden en .v2-grilla. -->
    <Style Selector=".ui2 DataGrid /template/ Border#DataGridBorder">
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Sin zebra: pisa DataGridRow:nth-child(2n) del tema viejo. -->
    <Style Selector=".ui2 DataGridRow, .ui2 DataGridRow:nth-child(2n)">
        <Setter Property="Background" Value="{DynamicResource V2SuperficieBrush}" />
    </Style>
    <Style Selector=".ui2 DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource V2HeaderGrillaBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector=".ui2 DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource V2AcentoSuaveBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector=".ui2 DataGridColumnHeader">
        <Setter Property="FontSize" Value="{DynamicResource V2FuenteHeaderColumnaTamano}" />
        <Setter Property="FontWeight" Value="{DynamicResource V2FuenteHeaderColumnaPeso}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource V2FuenteHeaderColumnaEspaciadoLetras}" />
        <Setter Property="Foreground" Value="{DynamicResource V2TextoTerciarioBrush}" />
        <Setter Property="Background" Value="{DynamicResource V2HeaderGrillaBrush}" />
        <!-- Padding derecho 4 (no 12): ver el comentario de ".ui2 DataGridCell" más abajo. El header
             usa el mismo que la celda para que una columna .num alineada a la derecha quede
             alineada con su título. -->
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Plantilla v2 del header: la misma de Fluent (Avalonia.Controls.DataGrid 12.0.1, mismos
         nombres de partes, así siguen valiendo los estilos del ControlTheme: :pointerover,
         :sortascending, :sortdescending, foco) con UN cambio: la columna de la flecha de orden es
         Auto SIN el MinWidth de 32 (DataGridSortIconMinWidth). Fluent reservaba ese hueco siempre
         y cortaba el texto de las columnas angostas ("CÓDIG" en la columna de 100 del catálogo,
         Task 17). Ahora el hueco aparece solo con la columna ordenada: la flecha (visible por
         :sortascending/:sortdescending) trae su propio Margin izquierdo de 8.
         La esquina superior izquierda (PART_TopLeftCornerHeader) conserva su plantilla propia. -->
    <Style Selector=".ui2 DataGridColumnHeader:not(#PART_TopLeftCornerHeader)">
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid Name="PART_ColumnHeaderRoot" ColumnDefinitions="*,Auto">
                        <Panel Margin="{TemplateBinding Padding}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Path Name="SortIcon"
                                      IsVisible="False"
                                      Grid.Column="1"
                                      Height="12"
                                      Margin="8,0,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{TemplateBinding Foreground}"
                                      Stretch="Uniform" />
                            </Grid>
                        </Panel>
                        <Rectangle Name="VerticalSeparator"
                                   Grid.Column="1"
                                   Width="1"
                                   VerticalAlignment="Stretch"
                                   Fill="{TemplateBinding SeparatorBrush}"
                                   IsVisible="{TemplateBinding AreSeparatorsVisible}" />
                        <Grid x:Name="FocusVisual" IsHitTestVisible="False" IsVisible="False">
                            <Rectangle x:Name="FocusVisualPrimary"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       Stroke="{DynamicResource DataGridCellFocusVisualPrimaryBrush}"
                                       StrokeThickness="2" />
                            <Rectangle x:Name="FocusVisualSecondary"
                                       Margin="2"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       Stroke="{DynamicResource DataGridCellFocusVisualSecondaryBrush}"
                                       StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector=".ui2 DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".ui2 DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
        <Setter Property="Fill" Value="{DynamicResource V2SeparadorGrillaBrush}" />
    </Style>

    <!-- Padding 12 a la izquierda y 4 a la derecha: con 12 simétrico, el texto que no entra en una
         columna angosta (ej. una hora "21:57") se cortaba 12 px antes del borde derecho y quedaba un
         hueco feo (medido con render Skia: 13 px entre la última tinta y el borde de la celda;
         ver DataGridV2EspacioDerechoCeldaTests). Mockup: .v2-grilla-celda en _base/base.css. -->
    <Style Selector=".ui2 DataGridCell">
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource V2FuenteControlTamano}" />
        <Setter Property="Foreground" Value="{DynamicResource V2TextoEtiquetaBrush}" />
    </Style>
    <!-- El TextBlock que genera DataGridTextColumn (CellTextBlock) trae Margin 12,0,12,0 del tema
         Fluent (medido: con Padding 12 de celda el texto quedaba a 24 del borde). El padding es uno
         solo, el de la celda, así las columnas de texto y las de template (Insignia) alinean igual. -->
    <Style Selector=".ui2 DataGridCell TextBlock#CellTextBlock">
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Columna numérica: derecha + cifras tabulares (spec §2.3). TextElement.FontFeatures se
         hereda al TextBlock de la celda (verificado con render Skia: "1111" pasa de 25 a 34 px).
         La alineación a la derecha la hace SOLO el TextBlock (selector de abajo). NO pongas
         HorizontalContentAlignment=Right acá: ajusta el ContentPresenter al contenido y, al
         ordenar (celdas recicladas), el número pierde el último carácter (el DesiredSize del presenter
         cambia durante el measure de la grilla sin invalidar su arrange). Ver DataGridCeldaNumericaOrdenTests. Guardián: DataGridV2ConBehaviorsGlobalesTests.
         TextoDeCeldaReciclada: al cambiar el número de una fila reciclada descarta el TextLayout del
         anterior; sin eso el TextBlock (ajustado a su contenido) podía quedar con el ancho del número
         viejo y cortar el nuevo. Guardián: MovimientoHistorialViewV2Tests
         (Buscar_ConLaGrillaOrdenadaYFilasRecicladas_NingunaCantidadQuedaCortada). -->
    <Style Selector=".ui2 DataGridCell.num">
        <Setter Property="TextElement.FontFeatures" Value="+tnum,-calt" />
    </Style>
    <Style Selector=".ui2 DataGridCell.num TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="b:TextoDeCeldaReciclada.Activo" Value="True" />
    </Style>
    <!-- Fila inactiva: el texto de la celda pasa a terciario por token, sin Opacity (con Opacity la insignia
         "Inactivo" de la misma fila quedaba atenuada y casi ilegible). La vista marca cada TextBlock de celda
         con Classes.inactivo bindeado a !Activo; la Insignia pinta su texto en su plantilla, sin la clase.
         Espejo: el modificador inactiva de .v2-grilla-fila en base.css. -->
    <Style Selector=".ui2 DataGridCell TextBlock.inactivo">
        <Setter Property="Foreground" Value="{DynamicResource V2TextoTerciarioBrush}" />
    </Style>
    <!-- Número negativo (stock): peligro texto #B91C1C de la spec, no el DangerBrush viejo. Va DESPUÉS de
         .inactivo a propósito: a igual especificidad gana el último, así un inactivo con stock negativo
         sigue en rojo. Espejo: .v2-texto-peligro en base.css. -->
    <Style Selector=".ui2 DataGridCell TextBlock.negativo">
        <Setter Property="Foreground" Value="{DynamicResource V2PeligroTextoBrush}" />
    </Style>

</Styles>
