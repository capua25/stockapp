<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.Actualizaciones"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
             x:Class="StockApp.Presentation.Actualizaciones.Views.ActualizacionBloqueoView"
             x:DataType="vm:ActualizacionBloqueoViewModel">

    <!-- Overlay rojo bloqueante (severity: critical). Sin opción de posponer. -->
    <!-- EsModoDegradado=false → bloqueo normal; EsModoDegradado=true → banner permanente. -->
    <Grid>

        <!-- BloqueoCritico: overlay modal -->
        <Border IsVisible="{Binding !EsModoDegradado}"
                Background="{DynamicResource DangerSuaveBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2"
                CornerRadius="{DynamicResource RadioBase}" Padding="{DynamicResource MargenVista}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="480">
            <StackPanel Spacing="{DynamicResource Espacio4}">

                <TextBlock Text="Actualizacion critica requerida"
                           Classes="seccion"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DangerPressedBrush}" />

                <TextBlock Text="{Binding TextoMarkdown}"
                           TextWrapping="Wrap"
                           Classes="body" />

                <Button Content="Aplicar y reiniciar"
                        Command="{Binding AplicarYReiniciarCommand}"
                        Classes="danger"
                        HorizontalAlignment="Right" />

            </StackPanel>
        </Border>

        <!-- ModoDegradado: banner rojo permanente no-cerrable en la parte superior -->
        <Border IsVisible="{Binding EsModoDegradado}"
                Background="{DynamicResource DangerPressedBrush}"
                Padding="12,6"
                VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}" VerticalAlignment="Center">
                <TextBlock Text="MODO DEGRADADO — Actualizacion critica no descargada. Reintentara al reiniciar."
                           Foreground="{DynamicResource SuperficieBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
