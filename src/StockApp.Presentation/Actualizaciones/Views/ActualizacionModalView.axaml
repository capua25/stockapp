<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.Actualizaciones"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
             x:Class="StockApp.Presentation.Actualizaciones.Views.ActualizacionModalView"
             x:DataType="vm:ActualizacionModalViewModel">

    <!-- Modal posponible (severity: important). App usable detrás. -->
    <Border Background="{DynamicResource WarningSuaveBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2"
            CornerRadius="{DynamicResource RadioBase}" Padding="{DynamicResource MargenVista}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="480">
        <StackPanel Spacing="{DynamicResource Espacio4}">

            <TextBlock Text="Actualización disponible"
                       Classes="seccion"
                       FontWeight="Bold" />

            <TextBlock Text="{Binding TextoMarkdown}"
                       TextWrapping="Wrap"
                       Classes="body" />

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}" HorizontalAlignment="Right">
                <Button Content="Posponer"
                        Command="{Binding PosponerCommand}"
                        IsVisible="{Binding EsPosponible}"
                        Classes="secondary" />
                <Button Content="Actualizar ahora"
                        Command="{Binding ActualizarAhoraCommand}"
                        Classes="primary" />
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
