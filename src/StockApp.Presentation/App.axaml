<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StockApp.Presentation.App"
             xmlns:local="using:StockApp.Presentation"
             RequestedThemeVariant="Light">
             <!-- Tema fijo claro (spec 2026-08-18). Todos los tokens de Themes/Tokens.axaml son
                  de tema claro y no hay ThemeDictionaries: con "Default", en un SO en modo oscuro
                  FluentTheme renderizaba en oscuro lo que él controla (fondo de ventana, TextBox,
                  ComboBox, DataGrid, scrollbars) mientras los tokens propios seguían claros,
                  resultado ilegible. La app tiene aspecto fijo, no negociado con el SO. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GestionMunicipal/Themes/Tokens.axaml"/>
                <ResourceInclude Source="avares://GestionMunicipal/Controls/Componentes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- StockApp UI Kit: capa aditiva, incluida DESPUÉS de FluentTheme para overridear.
             Reversible quitando estos StyleInclude. -->
        <StyleInclude Source="avares://GestionMunicipal/Themes/Typography.axaml"/>
        <StyleInclude Source="avares://GestionMunicipal/Themes/Controls.axaml"/>
        <!-- DESPUÉS del StyleInclude del Fluent.xaml del DataGrid (arriba): overridea el
             recuadro de foco de celda. Ver el comentario en DataGrid.axaml. -->
        <StyleInclude Source="avares://GestionMunicipal/Themes/DataGrid.axaml"/>
    </Application.Styles>
</Application>
