<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="clr-namespace:StockApp.Presentation.Converters;assembly=StockApp.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="StockApp.Presentation.Views.ShellMainView"
             x:DataType="vm:ShellMainViewModel">

    <Grid ColumnDefinitions="232,*" Background="{DynamicResource FondoBrush}">

        <!-- Menú lateral: pizarra media sólida, look dashboard SaaS.
             Classes="sidebar" es lo que activa la variante de texto blanco de
             Button.ghost (ver "Border.sidebar Button.ghost" en Controls.axaml) -->
        <Border Grid.Column="0"
                Classes="sidebar"
                Background="{DynamicResource SidebarBrush}"
                Padding="8">
            <DockPanel>

                <!-- Versión de la app: discreta, fija al pie del menú lateral -->
                <TextBlock Text="{Binding VersionTexto}"
                           Classes="caption"
                           Foreground="{DynamicResource TextoTerciarioBrush}"
                           DockPanel.Dock="Bottom"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,4" />

                <!-- Cerrar sesión: al pie del menú lateral, arriba de la versión -->
                <Button Command="{Binding CerrarSesionCommand}"
                        Classes="ghost"
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*">
                        <i:Icon Grid.Column="0" Value="mdi-logout" Foreground="{DynamicResource SidebarTextoBrush}" />
                        <TextBlock Grid.Column="1" Text="Cerrar sesión" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{DynamicResource Espacio1}">

                        <TextBlock Text="StockApp"
                                   Classes="titulo-vista"
                                   Foreground="{DynamicResource SidebarTextoBrush}"
                                   Margin="8,8,8,16" />

                        <!-- Inicio: fijo arriba, fuera de todo grupo, sin gate de permiso.
                             Classes.active bindea EstaActivo directamente (Ruling 2026-08-19,
                             ver ItemNavegacion.cs): ConverterParameter no acepta un {Binding},
                             así que ShellMainViewModel.OnSeccionActivaChanged ya lo calcula. -->
                        <Button Command="{Binding ItemInicio.Comando}"
                                Classes="ghost"
                                Classes.active="{Binding ItemInicio.EstaActivo}"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*">
                                <i:Icon Grid.Column="0" Value="{Binding ItemInicio.Icono}" Foreground="{DynamicResource SidebarTextoBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ItemInicio.Titulo}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>

                        <!-- Los 8 grupos colapsables. Reemplaza los 26 bloques copiados
                             literalmente (7 headers + 24 botones) que tenía este archivo. -->
                        <ItemsControl ItemsSource="{Binding Grupos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GrupoNavegacion">
                                    <StackPanel IsVisible="{Binding EsVisible}" Margin="0,8,0,0">

                                        <!-- $parent[ItemsControl] resolvería al ItemsControl MÁS
                                             CERCANO (el de items, no este de grupos), así que hay
                                             que subir hasta el UserControl — mismo patrón que
                                             DocumentoListView.axaml:65. -->
                                        <Button Command="{Binding $parent[UserControl].((vm:ShellMainViewModel)DataContext).AlternarGrupoCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Titulo}"
                                                           Classes="micro"
                                                           Foreground="{DynamicResource SidebarTextoBrush}"
                                                           VerticalAlignment="Center" />
                                                <i:Icon Grid.Column="1"
                                                        Value="{Binding EstaExpandido, Converter={x:Static conv:IconoChevronConverter.Instance}}"
                                                        Foreground="{DynamicResource SidebarTextoBrush}" />
                                            </Grid>
                                        </Button>

                                        <ItemsControl ItemsSource="{Binding ItemsVisibles}"
                                                      IsVisible="{Binding EstaExpandido}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ItemNavegacion">
                                                    <!-- Classes.active bindea EstaActivo directamente: un
                                                         ConverterParameter={Binding Seccion} no es viable acá
                                                         (ConverterParameter no acepta bindings en Avalonia). -->
                                                    <Button Command="{Binding Comando}"
                                                            Classes="ghost"
                                                            Classes.active="{Binding EstaActivo}"
                                                            HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <i:Icon Grid.Column="0" Value="{Binding Icono}" Foreground="{DynamicResource SidebarTextoBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Titulo}" VerticalAlignment="Center"
                                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Región de contenido: manejada por INavigationService + ViewLocator -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentContent}" />

    </Grid>

</UserControl>
