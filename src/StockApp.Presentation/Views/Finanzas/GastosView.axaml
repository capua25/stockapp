<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Finanzas"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:beh="using:StockApp.Presentation.Behaviors"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StockApp.Presentation.Views.Finanzas.GastosView"
             x:DataType="vm:GastosViewModel">

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="FINANZAS" Titulo="Gastos y facturas">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <!-- Nuevo/Editar: gateados por PuedeRegistrarGastos (bugfix 2026-08-15) - antes sin
                     gating, un Operador con VerFinanzas (alcanza para entrar a esta pantalla) pero sin
                     RegistrarGastos veia ambos botones habilitados: abria GastoFormView, llenaba el
                     formulario completo... y no habia boton "Guardar" (ese SI esta gateado por
                     PuedeRegistrarGastos en GastoFormView), una puerta a una habitacion sin salida. -->
                <Button Classes="primary" Content="Nuevo gasto" Command="{Binding NuevoCommand}"
                        IsVisible="{Binding PuedeRegistrarGastos}" />
                <Button Classes="secondary" Content="Editar" Command="{Binding EditarCommand}"
                        IsVisible="{Binding PuedeRegistrarGastos}" />
                <!-- Pagos: gateado por PuedeRegistrarPagos (bugfix 2026-08-15) - antes sin gating,
                     un Operador con VerFinanzas (alcanza para entrar a esta pantalla) pero sin
                     RegistrarPagos podia abrir el formulario y recien al guardar se comia un 403
                     (GastoService.RegistrarPagoAsync). -->
                <Button Classes="secondary" Content="Pagos" Command="{Binding PagosCommand}"
                        IsVisible="{Binding PuedeRegistrarPagos}" />
                <!-- Anular: gateado por PuedeRegistrarGastos (bugfix 2026-08-15) - antes solo gateado
                     por TieneSeleccion(), GastoService.AnularAsync exige Permisos.RegistrarGastos
                     sin condicion. -->
                <Button Classes="secondary" Content="Anular" Command="{Binding AnularCommand}"
                        IsVisible="{Binding PuedeRegistrarGastos}" />
                <Button Classes="secondary" Command="{Binding ExportarCsvCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-file-export" />
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding ExportarPdfCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-file-pdf-box" />
                        <TextBlock Text="Exportar PDF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:HeaderVista>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Desde" />
                        <CalendarDatePicker SelectedDate="{Binding FechaDesde}"
                                            PlaceholderText="dd/mm/aaaa"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            beh:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Hasta" />
                        <CalendarDatePicker SelectedDate="{Binding FechaHasta}"
                                            PlaceholderText="dd/mm/aaaa"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            beh:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" MinWidth="180">
                        <TextBlock Text="Proveedor" />
                        <ComboBox ItemsSource="{Binding ProveedoresDisponibles}"
                                  SelectedItem="{Binding ProveedorSeleccionado}"
                                  PlaceholderText="Todos"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" MinWidth="160">
                        <TextBlock Text="Fuente" />
                        <ComboBox ItemsSource="{Binding FuentesDisponibles}"
                                  SelectedItem="{Binding FuenteSeleccionada}"
                                  PlaceholderText="Todas"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" MinWidth="160">
                        <TextBlock Text="Rubro" />
                        <ComboBox ItemsSource="{Binding RubrosDisponibles}"
                                  SelectedItem="{Binding RubroSeleccionado}"
                                  PlaceholderText="Todos"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" MinWidth="160">
                        <TextBlock Text="Línea POA" />
                        <ComboBox ItemsSource="{Binding LineasPoaDisponibles}"
                                  SelectedItem="{Binding LineaPoaSeleccionada}"
                                  PlaceholderText="Todas"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" MinWidth="130">
                        <TextBlock Text="Estado" />
                        <ComboBox ItemsSource="{Binding EstadosDisponibles}"
                                  SelectedItem="{Binding EstadoSeleccionado}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                    <Button Classes="secondary" Content="Filtrar" Command="{Binding FiltrarCommand}" />
                    <Button Classes="secondary" Content="Limpiar" Command="{Binding LimpiarFiltrosCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grilla -->
        <!-- MinWidth por columna + scroll horizontal (fix/grillas-minwidth-scroll): sin esto, al
             angostar la ventana Avalonia.Controls.DataGrid comprime columnas arbitrarias hasta el
             piso global MinColumnWidth=40 (Themes/DataGrid.axaml) en vez de scrollear, y a 40px el
             padding de celda no deja entrar ni un carácter (header y valor desaparecen por
             clipping duro). Reproducido a mano a 1300px: colapsaban Proveedor/Detalle (con
             contenido real adentro) y Estado quedaba en una letra suelta. Proveedor/Detalle/
             Fuente/Rubro/Línea POA pasan a DataGridTemplateColumn (mismo patrón que
             ProveedorListView.axaml) porque son nombres libres de catálogo sin cota de longitud;
             Fecha/Factura/Monto/Pagado/Saldo/Estado son valores acotados (fecha corta, código,
             importe, enum) y no necesitan trimming, solo un piso que entre la palabra más larga. -->
        <DataGrid ItemsSource="{Binding FilasView}"
                  SelectedItem="{Binding FilaSeleccionada}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding Fecha, StringFormat='dd/MM/yyyy', DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="100" />
                <DataGridTemplateColumn Header="Proveedor" Width="*" MinWidth="160" SortMemberPath="ProveedorNombre">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GastoFila">
                            <TextBlock Text="{Binding ProveedorNombre}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ProveedorNombre}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Factura"
                                    Binding="{Binding NumeroFactura, DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="90" />
                <DataGridTemplateColumn Header="Detalle" Width="2*" MinWidth="160" SortMemberPath="Detalle">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GastoFila">
                            <TextBlock Text="{Binding Detalle}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Detalle}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Fuente" Width="Auto" MinWidth="150" SortMemberPath="FuenteNombre">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GastoFila">
                            <TextBlock Text="{Binding FuenteNombre}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FuenteNombre}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Rubro" Width="Auto" MinWidth="160" SortMemberPath="RubroNombre">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GastoFila">
                            <TextBlock Text="{Binding RubroNombre}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding RubroNombre}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Línea POA" Width="Auto" MinWidth="160" SortMemberPath="LineaPoaNombre">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GastoFila">
                            <TextBlock Text="{Binding LineaPoaNombre}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding LineaPoaNombre}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Monto"
                                    Binding="{Binding MontoTotal, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="100" />
                <DataGridTextColumn Header="Pagado"
                                    Binding="{Binding TotalPagado, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="100" />
                <DataGridTextColumn Header="Saldo"
                                    Binding="{Binding Saldo, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="100" />
                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado, DataType={x:Type vm:GastoFila}}"
                                    Width="Auto" MinWidth="90" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>

</UserControl>
