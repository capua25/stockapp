<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Finanzas"
             xmlns:e="using:StockApp.Domain.Entities"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:convA="using:Avalonia.Data.Converters"
             xmlns:beh="using:StockApp.Presentation.Behaviors"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="StockApp.Presentation.Views.Finanzas.PagosGastoView"
             x:DataType="vm:PagosGastoViewModel">

    <UserControl.Styles>
        <!-- Fix "botón sin ícono visible en celda de DataGrid" (mismo fix que
             IngresoPorFacturaView.axaml/NuevaImportacionView.axaml): Themes/DataGrid.axaml fija
             RowHeight=36 y DataGridCell.Padding=PaddingCelda (12,8) -> 36-16=20px útiles en la
             celda. El botón "Anular" (Padding propio + ícono mdi-cancel) necesita más alto que
             eso; sin este fix el ícono queda aplastado a 2px de alto (medido). Esta clase saca
             el padding VERTICAL de la celda (deja el horizontal) para que el botón tenga los
             36px enteros y su propio padding se resuelva adentro (medido: el ícono pasa de 2px
             a 13px de alto). -->
        <Style Selector="DataGridCell.sin-padding-vertical">
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="FINANZAS" Titulo="Pagos de la factura" Resumen="{Binding TituloGasto}" />

        <!-- Resumen -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio6}">
                <StackPanel>
                    <TextBlock Text="Monto total" Classes="caption" />
                    <TextBlock Text="{Binding MontoTotal, Converter={x:Static conv:MonedaConverter.Instance}}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Pagado" Classes="caption" />
                    <TextBlock Text="{Binding TotalPagado, Converter={x:Static conv:MonedaConverter.Instance}}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Saldo" Classes="caption" />
                    <TextBlock Text="{Binding SaldoPendiente, Converter={x:Static conv:MonedaConverter.Instance}}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Estado" Classes="caption" />
                    <TextBlock Text="{Binding Estado}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Registrar pago -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <!-- Panel de campos completo (bugfix 2026-08-16): el boton "Registrar pago" ya
                     estaba gateado por PuedeRegistrarPagos (bugfix 2026-08-15), pero el
                     formulario se seguia mostrando entero: un Operador sin RegistrarPagos podia
                     llenarlo y no tenia como guardarlo, el mismo callejon sin salida ya cerrado en
                     Gasto/Ingreso. Se oculta el panel completo, no solo el boton. -->
                <StackPanel x:Name="PanelRegistrarPago" Spacing="{DynamicResource Espacio2}"
                            IsVisible="{Binding PuedeRegistrarPagos}">
                    <TextBlock Text="Registrar pago" Classes="seccion" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Fecha" />
                            <CalendarDatePicker SelectedDate="{Binding FechaSeleccionada}"
                                                PlaceholderText="dd/mm/aaaa"
                                                SelectedDateFormat="Custom"
                                                CustomDateFormatString="dd/MM/yyyy"
                                                beh:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" MinWidth="140">
                            <TextBlock Text="Monto" />
                            <TextBox Text="{Binding MontoTexto}" Watermark="Ej.: 500,00" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" MinWidth="220">
                            <TextBlock Text="Nota (opcional)" />
                            <TextBox Text="{Binding Nota}" Watermark="Ej.: recibo 123" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding MensajeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                    <!-- Registrar pago: gateado por PuedeRegistrarPagos (bugfix 2026-08-15) - GastoService.
                         RegistrarPagoAsync exige Permisos.RegistrarPagos sin condicion. -->
                    <Button Classes="primary" Content="Registrar pago" Command="{Binding RegistrarPagoCommand}"
                            IsVisible="{Binding PuedeRegistrarPagos}" />
                    <!-- Volver queda SIEMPRE visible (bugfix 2026-08-16): a diferencia de otras
                         pantallas de Finanzas, esta siempre tiene un botón de acción disponible
                         para el usuario de solo lectura, no queda sin salida. -->
                    <Button Classes="secondary" Content="Volver" Command="{Binding VolverCommand}" />
                    <!-- Indicador "Solo lectura" (mismo patrón que IngresosView.axaml, commit
                         2243e23): con el formulario y el botón "Registrar pago" ocultos, el
                         usuario de solo lectura necesita saber por qué no puede hacer nada. -->
                    <TextBlock Text="Solo lectura" Classes="caption" VerticalAlignment="Center"
                               IsVisible="{Binding !PuedeRegistrarPagos}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Panel de adjuntos del pago seleccionado -->
        <ContentControl DockPanel.Dock="Top"
                         Content="{Binding AdjuntosPanel}"
                         IsVisible="{Binding PagoSeleccionado, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Margin="0,0,0,12" />

        <!-- Lista de pagos. Migrado de ListBox a DataGrid (2026-08-24): el ListBox no recibía
             nada del tema global (Themes/DataGrid.axaml — FontSize/RowHeight/resize), quedando
             visualmente desalineado del resto de la app. Columnas como DataGridTemplateColumn
             para poder portar el badge "Anulado" y el botón "Anular" tal cual estaban. A
             diferencia de ProveedorListView/UnidadMedidaListView, el ListBox original NO usaba
             ActivoOpacidadConverter acá (solo el badge "Anulado" marcaba el estado) — se
             preserva ese mismo criterio, sin agregar atenuación que no existía. -->
        <Border Classes="card">
            <DataGrid ItemsSource="{Binding Pagos}"
                      SelectedItem="{Binding PagoSeleccionado}"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Fecha" Width="Auto" MinWidth="100" SortMemberPath="Fecha">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="e:PagoGasto">
                                <TextBlock Text="{Binding Fecha, StringFormat='dd/MM/yyyy'}"
                                           VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Monto" Width="Auto" MinWidth="100" SortMemberPath="Monto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="e:PagoGasto">
                                <TextBlock Text="{Binding Monto, Converter={x:Static conv:MonedaConverter.Instance}}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nota" Width="*" MinWidth="160" SortMemberPath="Nota">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="e:PagoGasto">
                                <TextBlock Text="{Binding Nota}"
                                           Foreground="{DynamicResource TextoTerciarioBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Nota}"
                                           VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="e:PagoGasto">
                                <c:BadgeEstado Texto="Anulado" Tono="Neutro" IsVisible="{Binding !Activo}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Anular pago: IsVisible combina la condicion de DATOS (Activo: un pago ya
                         anulado no se vuelve a anular) con la de PERMISO (PuedeRegistrarPagos,
                         bugfix 2026-08-15) - GastoService.AnularPagoAsync exige
                         Permisos.RegistrarPagos sin condicion. $parent[UserControl] resuelve
                         igual que en un ListBox.ItemTemplate: el patrón ya está probado dentro de
                         una DataGridTemplateColumn en IngresoPorFacturaView.axaml (botón
                         "Quitar"), sin necesidad de cambiarlo acá. CellStyleClasses
                         "sin-padding-vertical" evita que el ícono quede aplastado (ver
                         UserControl.Styles arriba). -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="52" IsReadOnly="True"
                                             CellStyleClasses="sin-padding-vertical">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="e:PagoGasto">
                                <Button Classes="secondary"
                                        Command="{Binding $parent[UserControl].((vm:PagosGastoViewModel)DataContext).AnularPagoCommand}"
                                        CommandParameter="{Binding}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static convA:BoolConverters.And}">
                                            <Binding Path="Activo" />
                                            <Binding Path="$parent[UserControl].((vm:PagosGastoViewModel)DataContext).PuedeRegistrarPagos" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <i:Icon Value="mdi-cancel" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>

</UserControl>
