<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Finanzas"
             xmlns:e="using:StockApp.Domain.Entities"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Finanzas.PagosGastoView"
             x:DataType="vm:PagosGastoViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/finanzas/pagos*.html. Todo scrollea junto, encabezado incluido. Breadcrumb con el
         origen (Gastos y facturas o Calendario de pagos) que además es la vuelta: sin botón Volver. Cuatro cards apiladas
         (Resumen, Registrar pago, Pagos, Adjuntos). Sin finanzas.pagos o con el gasto anulado la pantalla es de solo lectura
         (sin Registrar ni Anular, insignia "Solo lectura"; anulado además con la insignia y la alerta). El pago elegido en la
         grilla gobierna el panel de adjuntos: el de un pago anulado se muestra en solo lectura con su aviso. Cargando, sin
         servidor y tras un 403 reemplazan a las cards. Fecha y Monto muestran su error debajo del campo (convención 31);
         la Alerta de error es para lo que rechaza el servidor. -->
    <ScrollViewer x:Name="Desplazamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">

            <v2:EncabezadoPagina x:Name="Encabezado" Titulo="Pagos de la factura" Subtitulo="{Binding TituloGasto}"
                                 BreadcrumbOrigen="{Binding TextoOrigen}"
                                 BreadcrumbComando="{Binding VolverCommand}"
                                 BreadcrumbActual="Pagos de la factura">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <v2:Insignia x:Name="InsigniaAnulado" Texto="Anulado" Variante="Neutro" IsVisible="{Binding EsAnulado}" />
                    <v2:Insignia x:Name="InsigniaSoloLectura" Texto="Solo lectura" Variante="Neutro" IsVisible="{Binding SoloLectura}" />
                </StackPanel>
            </v2:EncabezadoPagina>

            <v2:EstadoVacio x:Name="EstadoSinPermiso" UseLayoutRounding="False"
                            Titulo="Sin permiso" Mensaje="{Binding MensajeSinPermiso}" EsError="True"
                            IsVisible="{Binding SinPermiso}" />

            <v2:TarjetaContenido x:Name="TarjetaCargando" IsVisible="{Binding Cargando}">
                <v2:EstadoCargando x:Name="IndicadorCarga" Texto="Cargando los pagos…" />
            </v2:TarjetaContenido>

            <v2:TarjetaContenido x:Name="TarjetaSinConexion" IsVisible="{Binding SinConexion}">
                <v2:EstadoVacio x:Name="EstadoSinConexion" UseLayoutRounding="False"
                                Titulo="No se pudo conectar con el servidor"
                                Mensaje="Verificá que el servidor esté encendido y accesible en la red, y volvé a intentar."
                                EsError="True">
                    <Button x:Name="BotonReintentar" Classes="secundario" Content="Reintentar" Command="{Binding ReintentarCargaCommand}" />
                </v2:EstadoVacio>
            </v2:TarjetaContenido>

            <StackPanel x:Name="Contenido" Spacing="16">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Cargando" Converter="{x:Static BoolConverters.Not}" />
                        <Binding Path="SinPermiso" Converter="{x:Static BoolConverters.Not}" />
                        <Binding Path="SinConexion" Converter="{x:Static BoolConverters.Not}" />
                    </MultiBinding>
                </StackPanel.IsVisible>

                <v2:Alerta x:Name="AlertaAnulado" Variante="Info" IsVisible="{Binding EsAnulado}"
                           Texto="Este gasto está anulado: se pueden consultar sus pagos, pero no registrar ni anular." />

                <!-- Gasto de la caja POA al contado: el servidor rechaza el pago manual, así que la card de registrar se oculta y esto
                     explica por qué. -->
                <v2:Alerta x:Name="AlertaGastoPoa" Variante="Info" Texto="{Binding AvisoGastoPoa}"
                           IsVisible="{Binding AvisoGastoPoa, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Resumen: cuatro columnas iguales; el saldo de un gasto anulado es "—". -->
                <v2:TarjetaContenido x:Name="TarjetaResumen">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel>
                            <TextBlock Classes="texto-secundario" Text="Monto total" />
                            <TextBlock x:Name="ValorMontoTotal" Classes="titulo-seccion" TextElement.FontFeatures="+tnum,-calt"
                                       Text="{Binding MontoTotal, Converter={x:Static conv:MonedaConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="texto-secundario" Text="Pagado" />
                            <TextBlock x:Name="ValorPagado" Classes="titulo-seccion" TextElement.FontFeatures="+tnum,-calt"
                                       Text="{Binding TotalPagado, Converter={x:Static conv:MonedaConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="texto-secundario" Text="Saldo" />
                            <TextBlock x:Name="ValorSaldo" Classes="titulo-seccion" TextElement.FontFeatures="+tnum,-calt" Text="{Binding TextoSaldo}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Classes="texto-secundario" Text="Estado" />
                            <v2:Insignia x:Name="InsigniaEstado" Texto="{Binding Estado}" HorizontalAlignment="Left"
                                         Variante="{Binding Estado, Converter={x:Static conv:VarianteEstadoGastoConverter.Instance}}" />
                        </StackPanel>
                    </Grid>
                </v2:TarjetaContenido>

                <!-- Registrar pago: Fecha 140, Monto 160, Fuente 220, Nota (*) y el botón, con 8 de separación. El pago manual
                     sale siempre de la caja Local: sin selector de caja, solo el literal (arranca sin elegir). El botón queda arriba,
                     alineado con los inputs (19 = alto de la etiqueta con su separación), para que un error bajo un campo
                     no lo baje. -->
                <v2:TarjetaContenido x:Name="TarjetaRegistrar" IsVisible="{Binding PuedeRegistrar}">
                    <StackPanel>
                        <TextBlock Classes="titulo-seccion" Text="Registrar pago" Margin="0,0,0,12" />
                        <Grid ColumnDefinitions="140,8,160,8,220,8,*,8,Auto">
                            <v2:CampoFormulario x:Name="CampoFecha" Etiqueta="Fecha" Requerido="True">
                                <CalendarDatePicker x:Name="SelectorFecha" SelectedDate="{Binding FechaSeleccionada}"
                                                    PlaceholderText="dd/mm/aaaa" SelectedDateFormat="Custom"
                                                    CustomDateFormatString="dd/MM/yyyy" HorizontalAlignment="Stretch"
                                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario x:Name="CampoMonto" Grid.Column="2" Etiqueta="Monto" Requerido="True">
                                <TextBox x:Name="CajaMonto" Text="{Binding MontoTexto}" PlaceholderText="Ej.: 500,00" TextAlignment="Right" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario x:Name="CampoFuente" Grid.Column="4" Etiqueta="Fuente" Requerido="True">
                                <ComboBox x:Name="ComboFuente"
                                          ItemsSource="{Binding FuentesDisponibles}"
                                          SelectedItem="{Binding FuenteSeleccionada}"
                                          PlaceholderText="Elegí la fuente"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="e:FuenteFinanciamiento">
                                            <TextBlock Text="{Binding Nombre}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </v2:CampoFormulario>
                            <v2:CampoFormulario x:Name="CampoNota" Grid.Column="6" Etiqueta="Nota (opcional)">
                                <TextBox x:Name="CajaNota" Text="{Binding Nota}" PlaceholderText="Ej.: recibo 123" />
                            </v2:CampoFormulario>
                            <Button x:Name="BotonRegistrar" Grid.Column="8" Classes="primario" Content="Registrar pago"
                                    Command="{Binding RegistrarPagoCommand}" VerticalAlignment="Top" Margin="0,19,0,0" />
                        </Grid>
                        <!-- La caja Local no tiene literales activos: se avisa dónde configurarlos. -->
                        <v2:Alerta x:Name="AlertaSinLiterales" Margin="0,12,0,0" Variante="Advertencia"
                                   Texto="{Binding AvisoSinLiterales}"
                                   IsVisible="{Binding AvisoSinLiterales, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <v2:Alerta x:Name="AlertaError" Margin="0,12,0,0" Variante="Error" Texto="{Binding MensajeError}"
                                   IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </v2:TarjetaContenido>

                <!-- Pagos: cada TextBlock de celda lleva Classes.inactivo con el pago anulado (texto terciario por token).
                     FECHA y MONTO miden su contenido; ESTADO es un conjunto cerrado de ancho fijo medido (insignia
                     "Anulado" 64 + 16 de padding de celda); NOTA es la proporcional. La fecha es calendario:
                     FechaCortaConverter no la pasa a hora local (un pago del 12/10 a medianoche UTC no puede verse 11/10).
                     El orden por click va por PagosView (DataGridCollectionView). -->
                <v2:TarjetaContenido x:Name="TarjetaPagos">
                    <StackPanel>
                        <TextBlock x:Name="TituloPagos" Classes="titulo-seccion" Margin="0,0,0,12"
                                   Text="{Binding Pagos.Count, StringFormat='Pagos · {0}'}" />

                        <v2:EstadoVacio x:Name="EstadoSinPagos" UseLayoutRounding="False"
                                        Titulo="Todavía no hay pagos"
                                        Mensaje="Los pagos que se registren van a aparecer acá."
                                        IsVisible="{Binding Pagos.Count, Converter={x:Static conv:ConteoConverter.EsCero}}" />

                        <DataGrid x:Name="Grilla" ItemsSource="{Binding PagosView}" SelectedItem="{Binding PagoSeleccionado}"
                                  IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  IsVisible="{Binding Pagos.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="FECHA" Width="Auto" SortMemberPath="Fecha"
                                                        b:ColumnaAuto.Medir="True" b:ColumnaAuto.NoCede="True"
                                                        b:ColumnaAuto.Conversor="{x:Static conv:FechaCortaConverter.Instance}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <TextBlock Text="{Binding Fecha, Converter={x:Static conv:FechaCortaConverter.Instance}}"
                                                       Classes.inactivo="{Binding !Activo}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MONTO" Width="Auto" CellStyleClasses="num" SortMemberPath="Monto"
                                                        b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:MonedaConverter.Instance}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <TextBlock Text="{Binding Monto, Converter={x:Static conv:MonedaConverter.Instance}}"
                                                       Classes.inactivo="{Binding !Activo}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CAJA" Width="Auto" SortMemberPath="Caja"
                                                        b:ColumnaAuto.Medir="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <TextBlock Text="{Binding Caja, Converter={x:Static conv:CajaNombreConverter.Instance}}"
                                                       Classes.inactivo="{Binding !Activo}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="FUENTE" Width="Auto" SortMemberPath="FuenteFinanciamiento.Nombre"
                                                        b:ColumnaAuto.Medir="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <TextBlock Text="{Binding FuenteFinanciamiento.Nombre, FallbackValue='—', TargetNullValue='—'}"
                                                       Classes.inactivo="{Binding !Activo}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FuenteFinanciamiento.Nombre, FallbackValue='—', TargetNullValue='—'}"
                                                       b:TooltipSiSeCorta.Activo="True" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NOTA" Width="*" MinWidth="160" SortMemberPath="Nota">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <TextBlock Text="{Binding Nota}" Classes.inactivo="{Binding !Activo}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nota}"
                                                       b:TooltipSiSeCorta.Activo="True" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ESTADO" Width="80" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <v2:Insignia Texto="Anulado" Variante="Neutro" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         IsVisible="{Binding !Activo}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Anular: solo con un pago activo y con permiso (la columna no recibe el DataContext: el
                                     comando y el gate se resuelven por $parent[UserControl]). -->
                                <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserSort="False" CellStyleClasses="sin-padding-vertical">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="e:PagoGasto">
                                            <Button Classes="secundario" Content="Anular" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:PagosGastoViewModel)DataContext).AnularPagoCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Activo" />
                                                        <Binding Path="$parent[UserControl].((vm:PagosGastoViewModel)DataContext).PuedeRegistrar" />
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </v2:TarjetaContenido>

                <!-- Adjuntos del pago elegido (con un pago anulado, en solo lectura). Al elegir un pago el panel se trae a la vista (el comportamiento va en el panel y no en la card: la card ya visible
                     crece al cargar y la pantalla se abriría scrolleada). -->
                <v2:TarjetaContenido x:Name="TarjetaAdjuntos">
                    <StackPanel>
                        <TextBlock x:Name="TextoElegiPago" Classes="texto-secundario"
                                   Text="Elegí un pago de la lista para ver sus adjuntos."
                                   IsVisible="{Binding SinPagoSeleccionado}" />
                        <ContentControl x:Name="PanelAdjuntos" Content="{Binding AdjuntosPanel}" IsVisible="{Binding MostrarAdjuntos}"
                                        b:TraerALaVista.AlMostrarse="True" />
                    </StackPanel>
                </v2:TarjetaContenido>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
