<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Finanzas"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:dto="using:StockApp.Application.Finanzas"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StockApp.Presentation.Views.Finanzas.ControlPoaView"
             x:DataType="vm:ControlPoaViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="{DynamicResource MargenVista}">

        <c:HeaderVista Grid.Row="0" Eyebrow="FINANZAS" Titulo="Control POA">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <Button Classes="primary" Content="Actualizar" Command="{Binding RecargarCommand}" />
                <Button Classes="secondary" Content="Exportar CSV" Command="{Binding ExportarCsvCommand}" />
                <Button Classes="secondary" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
            </StackPanel>
        </c:HeaderVista>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,12">
            <c:CampoFormulario Etiqueta="Ejercicio">
                <NumericUpDown Value="{Binding Ejercicio}" Minimum="2020" Maximum="2100" Width="120" />
            </c:CampoFormulario>
        </StackPanel>

        <!-- MinWidth por columna + scroll horizontal (fix/grillas-minwidth-scroll): sin esto,
             Avalonia.Controls.DataGrid comprime columnas arbitrarias hasta el piso global
             MinColumnWidth=40 (Themes/DataGrid.axaml) en vez de scrollear. Línea/Programa pasan a
             MinWidth de texto largo; el resto son importes/porcentaje acotados. -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilasView}"
                  SelectedItem="{Binding FilaSeleccionada}"
                  DoubleTapped="OnFilaDobleClick"
                  AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Línea" Width="*" MinWidth="160" SortMemberPath="Nombre">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:ControlPoaLineaDto">
                            <TextBlock Text="{Binding Nombre}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Nombre}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Programa" Width="Auto" MinWidth="150" SortMemberPath="Programa">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:ControlPoaLineaDto">
                            <TextBlock Text="{Binding Programa}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Programa}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Presupuesto"
                                     Binding="{Binding Presupuesto, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type dto:ControlPoaLineaDto}}"
                                     MinWidth="100" />
                <DataGridTextColumn Header="Gastado"
                                     Binding="{Binding Gastado, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type dto:ControlPoaLineaDto}}"
                                     MinWidth="100" />
                <DataGridTemplateColumn Header="Saldo" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="dto:ControlPoaLineaDto">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio1}">
                                <c:BadgeEstado Texto="Sobreejecutado" Tono="Peligro"
                                               IsVisible="{Binding Saldo, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                <TextBlock Text="{Binding Saldo, Converter={x:Static conv:MonedaConverter.Instance}}"
                                           Foreground="{Binding Saldo, Converter={x:Static conv:SignoNegativoBrushConverter.Instance}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="% Ejecución" Binding="{Binding PorcentajeEjecucion, DataType={x:Type dto:ControlPoaLineaDto}}" MinWidth="90" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
