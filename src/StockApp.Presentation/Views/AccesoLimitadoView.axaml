<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:admin="using:StockApp.Presentation.Views.Administracion"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="StockApp.Presentation.Views.AccesoLimitadoView"
             x:DataType="vm:AccesoLimitadoViewModel"
             Background="{DynamicResource V2FondoBrush}">

    <!-- Modo acotado (FIX 1, re-review final E1): a propósito NO hay sidebar ni ContentControl
         genérico atado a INavigationService acá — a diferencia de ShellMainView, esta vista
         hostea EXCLUSIVAMENTE MantenimientoView. Es la barrera física que impide navegar a
         Productos/Finanzas/Reportes con la licencia vencida. -->
    <DockPanel>

        <!-- UI v2 (Fase 1, P3): solo el aviso. Classes="ui2" va en este Border y NO en la raíz: la raíz usa el fondo v2
             y MantenimientoView, ya v2, lleva su propia raíz ui2. -->
        <Border x:Name="AvisoAccesoLimitado"
                DockPanel.Dock="Top"
                Classes="ui2"
                Margin="16,16,16,0">
            <v2:Alerta Variante="Advertencia"
                       Texto="Modo de acceso limitado: la licencia está vencida. Solo podés descargar backups; para operar el sistema, activá la licencia." />
        </Border>

        <admin:MantenimientoView DataContext="{Binding Mantenimiento}" />

    </DockPanel>

</UserControl>
