<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Tareas"
             xmlns:dom="using:StockApp.Domain.Entities"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="710" d:DesignHeight="160"
             x:Class="StockApp.Presentation.Views.Tareas.ClasificacionTareaPanelView"
             x:DataType="vm:ClasificacionTareaPanelViewModel"
             Classes="ui2">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/gestion/tarea-nueva.html y reclasificar-tarea.html. Panel embebido en el alta de
         tarea y en el diálogo de reclasificar: lo inicializa el host (InicializarAsync). Los dos campos son opcionales
         (sin "*"); el combo de proyecto tiene la opción "(ninguno)" y ofrece solo proyectos pendientes o en curso.
         El 16 entre filas va en el Margin superior de cada campo. -->
    <Grid RowDefinitions="Auto,Auto">

        <v2:CampoFormulario x:Name="CampoProyecto" Grid.Row="0" Etiqueta="Proyecto">
            <ComboBox x:Name="ComboProyecto" HorizontalAlignment="Stretch" PlaceholderText="Elegí el proyecto"
                      ItemsSource="{Binding ProyectosDisponibles}" SelectedItem="{Binding ProyectoSeleccionado}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcionProyectoTarea"><TextBlock Text="{Binding Nombre}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </v2:CampoFormulario>

        <!-- Numero a secas NO es único, solo lo es (Tipo, Anio, Numero): el texto elegido y cada fila del desplegable llevan
             Numero/Anio. El mensaje del buscador (sin permiso para buscar, demasiados resultados) va debajo, en texto
             secundario. -->
        <v2:CampoFormulario x:Name="CampoExpediente" Grid.Row="1" Margin="0,16,0,0" Etiqueta="Expediente">
            <StackPanel Spacing="4">
                <AutoCompleteBox x:Name="BuscadorExpediente" Watermark="Buscar expediente por número o descripción..."
                                 AsyncPopulator="{Binding BuscarExpedientesAsync}"
                                 SelectedItem="{Binding DocumentoSeleccionado}"
                                 FilterMode="None"
                                 MinimumPopulateDelay="0:0:0.3"
                                 HorizontalAlignment="Stretch">
                    <AutoCompleteBox.ValueMemberBinding>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="Numero" DataType="{x:Type dom:DocumentoAdministrativo}" />
                            <Binding Path="Anio" DataType="{x:Type dom:DocumentoAdministrativo}" />
                        </MultiBinding>
                    </AutoCompleteBox.ValueMemberBinding>
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="dom:DocumentoAdministrativo">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}Expediente {0}/{1}">
                                        <Binding Path="Numero" />
                                        <Binding Path="Anio" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <TextBlock x:Name="MensajeExpediente" Classes="texto-secundario" TextWrapping="Wrap"
                           Text="{Binding MensajeBuscadorExpediente}"
                           IsVisible="{Binding MensajeBuscadorExpediente, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </v2:CampoFormulario>

    </Grid>

</UserControl>
