<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StockApp.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="400"
        x:Class="StockApp.Presentation.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Gestión Municipal"
        MinWidth="400"
        MinHeight="300">

    <Grid RowDefinitions="Auto,*">
        <!-- Fila propia de la franja crítica en sesión (no cerrable). Auto: mide 0 mientras no hay
             franja y 56 cuando la hay, así el contenido de la fila 1 se achica exactamente ese alto
             y nada queda tapado. Decisión de Martin, 2026-10-19: supera al overlay en la misma capa. -->
        <ContentControl Grid.Row="0"
                        Content="{Binding AvisoCriticoEnSesion}"
                        IsVisible="{Binding AvisoCriticoEnSesion, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid Grid.Row="1">
            <!-- Capa base: contenido principal de la app (login, catálogo, etc.) -->
            <ContentControl Content="{Binding CurrentViewModel}" />

            <!-- Capa superior: overlay de actualización flotante (banner, modal o bloqueo).
                 Cuando OverlayFlotanteActualizacion es null, el ContentControl no renderiza nada.
                 HorizontalContentAlignment/VerticalContentAlignment en Stretch: cada overlay
                 define su propia alineación (el banner se ancla arriba, el modal/bloqueo se
                 centran) mediante el HorizontalAlignment/VerticalAlignment de su Border raíz. -->
            <ContentControl Content="{Binding OverlayFlotanteActualizacion}"
                            IsVisible="{Binding OverlayFlotanteActualizacion, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>

</Window>
