<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:e="using:StockApp.Domain.Entities"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="StockApp.Presentation.Views.Catalogo.UnidadMedidaListView"
             x:DataType="vm:UnidadMedidaListViewModel">

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="CATÁLOGO" Titulo="Unidades de medida">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <Button Classes="primary"
                        Content="Nueva unidad"
                        Command="{Binding NuevoCommand}" />
                <Button Classes="secondary"
                        Content="Editar"
                        Command="{Binding EditarCommand}" />
                <Button Classes="secondary"
                        Content="Dar de baja"
                        Command="{Binding BajaCommand}" />
            </StackPanel>
        </c:HeaderVista>

        <Border Classes="card">
            <DockPanel>

                <!-- Migrado de ListBox a DataGrid (2026-08-24), mismo molde que
                     ProveedorListView.axaml: el tema global (Themes/DataGrid.axaml) da
                     FontSize/RowHeight/resize gratis, cosa que el ListBox no recibía. Migración
                     mecánica — no se agregan columnas nuevas, Nombre/Abreviatura ya entraban en
                     el ListBox. Cada celda de dato se atenúa individualmente con
                     ActivoOpacidadConverter (no la DataGridRow entera) para que el badge
                     "Inactiva" quede a opacidad plena, igual criterio que
                     ProductoListView.axaml/ProveedorListView.axaml. -->
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding ItemSeleccionado}"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="140" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="e:UnidadMedida">
                                    <TextBlock Text="{Binding Nombre}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Nombre}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Abreviatura" Width="Auto" MinWidth="90" SortMemberPath="Abreviatura">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="e:UnidadMedida">
                                    <TextBlock Text="{Binding Abreviatura}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               Foreground="{DynamicResource TextoTerciarioBrush}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="e:UnidadMedida">
                                    <c:BadgeEstado Texto="Inactiva" Tono="Neutro" IsVisible="{Binding !Activo}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

    </DockPanel>

</UserControl>
