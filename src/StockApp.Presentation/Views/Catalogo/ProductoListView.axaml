<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:dto="using:StockApp.Application.Catalogo"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="StockApp.Presentation.Views.Catalogo.ProductoListView"
             x:DataType="vm:ProductoListViewModel">

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="CATÁLOGO" Titulo="Productos">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <Button Classes="secondary" Content="Buscar" Command="{Binding BuscarCommand}" />
                <Button Classes="secondary" Content="Editar" Command="{Binding EditarCommand}" />
                <Button Classes="secondary" Content="Eliminar" Command="{Binding BajaCommand}" />
                <Button Classes="primary" Content="Nuevo" Command="{Binding NuevoCommand}" />
            </StackPanel>
        </c:HeaderVista>

        <Border Classes="card">
            <DockPanel>

                <!-- Filtro de busqueda de la grilla (no es accion de vista: se queda en la card).
                     Etiquetado con CampoFormulario por consistencia: el mismo caso de uso (filtro
                     de texto arriba de un listado) ya lleva Etiqueta="Buscar" en
                     DocumentoListView, y acá no hay ícono de lupa que lo explique solo. -->
                <c:CampoFormulario DockPanel.Dock="Top" Etiqueta="Buscar" Margin="0,0,0,12">
                    <TextBox Text="{Binding FiltroBusqueda}"
                             PlaceholderText="Buscar por nombre, SKU o código de barras..." />
                </c:CampoFormulario>

                <!-- Listado. Columnas como DataGridTemplateColumn (no DataGridTextColumn) para
                     poder atenuar el contenido de cada celda de datos con ActivoOpacidadConverter
                     y, a la vez, dejar la columna "Estado" (badge "Inactiva") a opacidad plena:
                     la opacidad en Avalonia es multiplicativa por el árbol visual, así que un
                     badge atenuado por herencia desde una fila entera no sería legible — por eso
                     se atenúa celda por celda en vez de la DataGridRow completa. SortMemberPath
                     mantiene el ordenamiento por click en encabezados (CanUserSortColumns). -->
                <DataGrid ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding ItemSeleccionado}"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Código" Width="Auto" SortMemberPath="Codigo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <TextBlock Text="{Binding Codigo}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nombre" Width="2*" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <TextBlock Text="{Binding Nombre}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Nombre}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Costo" Width="Auto" MinWidth="100" SortMemberPath="PrecioCosto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <TextBlock Text="{Binding PrecioCosto, Converter={x:Static conv:MonedaConverter.Instance}}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Stock" Width="220" MinWidth="100" SortMemberPath="StockActual">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <!-- Columna de ANCHO FIJO (220) + badge y número en UNA sola celda de Grid
                                         (badge pegado a la izquierda, número a la derecha). Antes era una
                                         columna Auto con un StackPanel Right que se ajustaba al contenido:
                                         la grilla recicla las celdas al ordenar por encabezado, y cuando una
                                         celda que mostraba un stock negativo (badge visible) pasa a mostrar
                                         uno positivo (badge oculto), el contenedor conservaba el arreglo del
                                         valor anterior y el número quedaba corrido o recortado (22 se veía
                                         como "2"). Con ancho fijo y sin tamaño que dependa de la visibilidad
                                         del badge, no hay nada que re-medir. 220 = peor caso "-99999,5": badge
                                         "Stock negativo" (102) + número (62) + padding de celda y margen, igual
                                         que las otras 4 grillas con badge; con 170 el badge pisaba 41px al número
                                         (ProductoListViewStockOrdenTests). -->
                                    <Grid Margin="4,0" VerticalAlignment="Center"
                                          Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}">
                                        <c:BadgeEstado Texto="Stock negativo" Tono="Peligro"
                                                       HorizontalAlignment="Left"
                                                       IsVisible="{Binding StockActual, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                        <TextBlock Text="{Binding StockActual, Converter={x:Static conv:CantidadConverter.Instance}}"
                                                   Foreground="{Binding StockActual, Converter={x:Static conv:SignoNegativoBrushConverter.Instance}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Unidad" Width="Auto" SortMemberPath="UnidadMedidaNombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <TextBlock Text="{Binding UnidadMedidaNombre}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Categoría" Width="*" SortMemberPath="CategoriaNombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <TextBlock Text="{Binding CategoriaNombre, TargetNullValue='—'}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding CategoriaNombre, TargetNullValue='—'}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ProductoDto">
                                    <c:BadgeEstado Texto="Inactiva" Tono="Neutro" IsVisible="{Binding !Activo}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

    </DockPanel>

</UserControl>
