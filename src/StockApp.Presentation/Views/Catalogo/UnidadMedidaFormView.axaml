<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="280"
             x:Class="StockApp.Presentation.Views.Catalogo.UnidadMedidaFormView"
             x:DataType="vm:UnidadMedidaFormViewModel">

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="CATÁLOGO" Titulo="{Binding Titulo}" />

        <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="{DynamicResource Espacio3}" MaxWidth="420" HorizontalAlignment="Left">

                <c:CampoFormulario Etiqueta="Nombre" Requerido="True">
                    <TextBox Text="{Binding Nombre}"
                             PlaceholderText="Ej: Kilogramo" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Abreviatura" Requerido="True">
                    <TextBox Text="{Binding Abreviatura}"
                             PlaceholderText="Ej: kg" />
                </c:CampoFormulario>

                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                    <Button Classes="primary" Content="Guardar" Command="{Binding GuardarCommand}" />
                    <Button Classes="secondary" Content="Cancelar" Command="{Binding CancelarCommand}" />
                </StackPanel>

            </StackPanel>
        </Border>

    </DockPanel>

</UserControl>
