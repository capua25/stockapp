<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="StockApp.Presentation.Views.Catalogo.ProductoFormView"
             x:DataType="vm:ProductoFormViewModel">

    <ScrollViewer>
        <Border Classes="card" Padding="{DynamicResource MargenVista}" Margin="{DynamicResource MargenVista}"
                MaxWidth="480">
            <StackPanel Spacing="{DynamicResource Espacio3}">

                <c:HeaderVista Titulo="{Binding Titulo}" />

                <c:CampoFormulario Etiqueta="SKU" Requerido="True">
                    <!-- En modo edición el SKU no es editable: ProductoService.ModificarAsync
                         ignora cambios al Código (no lo reasigna sobre la entidad original),
                         así que permitir tipearlo confundiría al usuario sin efecto real. -->
                    <TextBox Text="{Binding Codigo}"
                             IsEnabled="{Binding !EsEdicion}"
                             PlaceholderText="Ej: P001" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Nombre" Requerido="True">
                    <TextBox Text="{Binding Nombre}"
                             PlaceholderText="Nombre del producto" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Código de barras">
                    <TextBox Text="{Binding CodigoBarras}"
                             PlaceholderText="EAN (opcional)" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Descripción">
                    <TextBox Text="{Binding Descripcion}"
                             PlaceholderText="Descripción opcional"
                             AcceptsReturn="True"
                             Height="60" />
                </c:CampoFormulario>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Precio costo" Margin="0,0,8,4" />
                    <TextBlock Grid.Column="1" Text="Precio venta" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding PrecioCosto}"
                             Margin="0,0,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding PrecioVenta}" />
                </Grid>

                <c:CampoFormulario Etiqueta="Unidad de medida">
                    <ComboBox ItemsSource="{Binding UnidadesMedida}"
                              SelectedItem="{Binding UnidadMedidaSeleccionada}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Categoría">
                    <ComboBox ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaSeleccionada}"
                              PlaceholderText="Sin categoría"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </c:CampoFormulario>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <Button Classes="primary"
                        Content="Guardar"
                        Command="{Binding GuardarCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
