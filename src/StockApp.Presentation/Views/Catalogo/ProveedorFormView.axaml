<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Catalogo.ProveedorFormView"
             x:DataType="vm:ProveedorFormViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2 (formulario §5.2). Espejo: docs/ui-v2/mockups/administracion/. Los diez formularios de catálogo comparten esta
         estructura: breadcrumb que vuelve a Catálogos con su catálogo, card de 760 con una sola sección, asterisco solo en lo
         que exige el botón Guardar, error del servidor en una Alerta arriba del pie y un solo primario. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">

            <v2:EncabezadoPagina x:Name="Encabezado"
                                 Titulo="{Binding Titulo}"
                                 BreadcrumbOrigen="Proveedores"
                                 BreadcrumbComando="{Binding CancelarCommand}"
                                 BreadcrumbActual="{Binding Titulo}" />

            <Grid x:Name="ColumnaFormulario" UseLayoutRounding="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource V2AnchoFormularioMax}" />
                </Grid.ColumnDefinitions>

                <v2:TarjetaContenido x:Name="Tarjeta" Padding="24" UseLayoutRounding="True">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto,16,Auto">
                            <v2:CampoFormulario Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Etiqueta="Nombre" Requerido="True">
                                <TextBox x:Name="CajaNombre" Text="{Binding Nombre}" PlaceholderText="Nombre del proveedor" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario Grid.Row="2" Grid.Column="0" Etiqueta="Teléfono">
                                <TextBox x:Name="CajaTelefono" Text="{Binding Telefono}" PlaceholderText="Teléfono (opcional)" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario Grid.Row="2" Grid.Column="2" Etiqueta="Email">
                                <TextBox x:Name="CajaEmail" Text="{Binding Email}" PlaceholderText="Email (opcional)" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Etiqueta="Dirección">
                                <TextBox x:Name="CajaDireccion" Text="{Binding Direccion}" PlaceholderText="Dirección (opcional)" />
                            </v2:CampoFormulario>
                            <v2:CampoFormulario Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Etiqueta="Notas">
                                <TextBox x:Name="CajaNotas" Text="{Binding Notas}" PlaceholderText="Notas adicionales" AcceptsReturn="True" Height="60" />
                            </v2:CampoFormulario>
                        </Grid>

                        <v2:Alerta x:Name="AlertaError" Margin="0,16,0,0" Variante="Error"
                                   Texto="{Binding MensajeError}"
                                   IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Border x:Name="PieFormulario" Margin="0,20,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource V2SeparadorGrillaBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="BotonCancelar" Classes="secundario" Content="Cancelar" Command="{Binding CancelarCommand}" />
                                <Button x:Name="BotonGuardar" Classes="primario" Content="Guardar" Command="{Binding GuardarCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </v2:TarjetaContenido>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
