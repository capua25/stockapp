<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Catalogo"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="420"
             x:Class="StockApp.Presentation.Views.Catalogo.ProveedorFormView"
             x:DataType="vm:ProveedorFormViewModel">

    <ScrollViewer>
        <Border Classes="card" Padding="{DynamicResource MargenVista}" Margin="{DynamicResource MargenVista}"
                MaxWidth="460">
            <StackPanel Spacing="{DynamicResource Espacio3}">

                <c:HeaderVista Titulo="{Binding Titulo}" />

                <c:CampoFormulario Etiqueta="Nombre" Requerido="True">
                    <TextBox Text="{Binding Nombre}"
                             PlaceholderText="Nombre del proveedor" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Teléfono">
                    <TextBox Text="{Binding Telefono}"
                             PlaceholderText="Teléfono (opcional)" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Email">
                    <TextBox Text="{Binding Email}"
                             PlaceholderText="Email (opcional)" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Dirección">
                    <TextBox Text="{Binding Direccion}"
                             PlaceholderText="Dirección (opcional)" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Notas">
                    <TextBox Text="{Binding Notas}"
                             PlaceholderText="Notas adicionales"
                             AcceptsReturn="True"
                             Height="60" />
                </c:CampoFormulario>

                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <Button Classes="primary"
                        Content="Guardar"
                        Command="{Binding GuardarCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
