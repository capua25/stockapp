<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Movimientos"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="StockApp.Presentation.Views.Movimientos.MovimientoFormControl"
             x:DataType="vm:MovimientoRegistroViewModelBase">

    <ScrollViewer>
        <Border Classes="card" Padding="{DynamicResource MargenVista}" Margin="{DynamicResource MargenVista}"
                MaxWidth="480">
            <StackPanel Spacing="{DynamicResource Espacio3}">

                <c:HeaderVista Titulo="{Binding Titulo}" />

                <c:CampoFormulario Etiqueta="Producto" Requerido="True">
                    <ComboBox ItemsSource="{Binding Productos}"
                              SelectedItem="{Binding ProductoSeleccionado}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Cantidad" Requerido="True">
                    <TextBox Text="{Binding Cantidad}"
                             PlaceholderText="Ingresá la cantidad" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Motivo">
                    <ComboBox ItemsSource="{Binding MotivosDisponibles}"
                              SelectedItem="{Binding Motivo}"
                              HorizontalAlignment="Stretch" />
                </c:CampoFormulario>

                <!-- PrecioUnitario es decimal? (opcional): el conversor default de Avalonia
                     no mapea "" a null y explota con InvalidCastException al vaciar el campo
                     (bug real reproducido en tests). DecimalOpcionalConverter trata "" como
                     null y, si el texto no es numérico, devuelve un BindingNotification en
                     vez de lanzar (ver Converters/DecimalOpcionalConverter.cs).
                     x:Name="PrecioUnitarioBox" queda en el TextBox, NUNCA se mueve al
                     CampoFormulario (Task 6.4): MovimientoFormControlValidacionTests busca
                     t.Name == "PrecioUnitarioBox" sobre window.GetVisualDescendants(), y el
                     TextBox sigue en el mismo NameScope porque CampoFormulario lo proyecta por
                     ContentPresenter, no por template propio. -->
                <c:CampoFormulario Etiqueta="Precio unitario">
                    <TextBox Name="PrecioUnitarioBox"
                             Text="{Binding PrecioUnitario, Converter={x:Static conv:DecimalOpcionalConverter.Instance}}"
                             PlaceholderText="Opcional" />
                </c:CampoFormulario>

                <c:CampoFormulario Etiqueta="Comentario">
                    <TextBox Text="{Binding Comentario}"
                             PlaceholderText="Comentario opcional"
                             AcceptsReturn="True"
                             Height="60" />
                </c:CampoFormulario>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <Button Classes="primary"
                        Content="Registrar"
                        Command="{Binding RegistrarCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
