<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Movimientos"
             xmlns:dto="using:StockApp.Application.Movimientos"
             xmlns:cat="using:StockApp.Application.Catalogo"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Movimientos.MovimientoHistorialView"
             x:DataType="vm:MovimientoHistorialViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2 (spec §5.1). Espejo: docs/ui-v2/mockups/inventario/historial*.html.
         Encabezado con una sola acción, "Recalcular stock" (secundario: la pantalla no tiene acción principal), oculta
         sin stock.recalcular; abre el diálogo con el buscador de producto. Mientras carga sin filas: EstadoCargando;
         tras un 403 en la carga o en Buscar: Sin permiso en lugar de la card; el vacío solo con la carga terminada. -->
    <DockPanel Margin="28,24">

        <v2:EncabezadoPagina x:Name="Encabezado" DockPanel.Dock="Top" Titulo="Historial de movimientos">
            <Button x:Name="BotonRecalcular" Classes="secundario" Content="Recalcular stock"
                    Command="{Binding AbrirRecalcularCommand}"
                    IsVisible="{Binding PuedeRecalcularStock}" />
        </v2:EncabezadoPagina>

        <!-- Sin permiso (403 en la carga o en una búsqueda): reemplaza a la card, como en Productos. -->
        <v2:EstadoVacio x:Name="EstadoSinPermiso"
                        DockPanel.Dock="Top"
                        UseLayoutRounding="False"
                        Titulo="Sin permiso"
                        Mensaje="{Binding MensajeSinPermiso}"
                        EsError="True"
                        IsVisible="{Binding SinPermiso}" />

        <v2:TarjetaContenido x:Name="Tarjeta" IsVisible="{Binding !SinPermiso}">
            <DockPanel>
                <!-- Sin búsqueda libre: los filtros llevan etiqueta arriba porque con dos fechas elegidas las marcas de
                     agua desaparecen y Desde y Hasta ya no se distinguen. Sin catalogo.productos (o tras un 403 al
                     buscar uno) el campo Producto desaparece y los demás corren a la izquierda, sin hueco. -->
                <v2:BarraFiltros x:Name="Filtros" DockPanel.Dock="Top" MostrarBusqueda="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Búsqueda en el servidor (ILIKE sobre código, código de barras y nombre): FilterMode None
                             para no volver a filtrar del lado del cliente lo que el servidor ya encontró por código.
                             Sin selección es "todos los productos". -->
                        <v2:CampoFormulario x:Name="CampoProducto" Etiqueta="Producto" IsVisible="{Binding PuedeFiltrarPorProducto}">
                            <AutoCompleteBox Width="280"
                                             PlaceholderText="Todos los productos"
                                             AsyncPopulator="{Binding BuscarProductosParaFiltroAsync}"
                                             SelectedItem="{Binding ProductoFiltroSeleccionado}"
                                             ValueMemberBinding="{Binding Nombre, DataType={x:Type cat:ProductoDto}}"
                                             FilterMode="None"
                                             MinimumPopulateDelay="0:0:0.3">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="cat:ProductoDto">
                                        <TextBlock Text="{Binding Nombre}" />
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </v2:CampoFormulario>

                        <v2:CampoFormulario Etiqueta="Tipo">
                            <ComboBox ItemsSource="{Binding TiposDisponibles}"
                                      SelectedItem="{Binding TipoFiltroSeleccionado}"
                                      Width="140">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OpcionTipoMovimiento">
                                        <TextBlock Text="{Binding Nombre}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </v2:CampoFormulario>

                        <v2:CampoFormulario Etiqueta="Desde">
                            <CalendarDatePicker Width="140"
                                                SelectedDate="{Binding FechaDesde}"
                                                PlaceholderText="dd/mm/aaaa"
                                                SelectedDateFormat="Custom"
                                                CustomDateFormatString="dd/MM/yyyy"
                                                b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                        </v2:CampoFormulario>

                        <v2:CampoFormulario Etiqueta="Hasta">
                            <CalendarDatePicker Width="140"
                                                SelectedDate="{Binding FechaHasta}"
                                                PlaceholderText="dd/mm/aaaa"
                                                SelectedDateFormat="Custom"
                                                CustomDateFormatString="dd/MM/yyyy"
                                                b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                        </v2:CampoFormulario>

                        <Button x:Name="BotonBuscar" Classes="secundario" Content="Buscar"
                                Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" />
                    </StackPanel>
                </v2:BarraFiltros>

                <TextBlock x:Name="PieConteo"
                           DockPanel.Dock="Bottom"
                           Classes="pie-conteo"
                           Margin="0,12,0,0"
                           Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='movimiento|movimientos'}"
                           IsVisible="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}" />

                <!-- Cargando y todavía sin filas: dice que carga en vez de afirmar que no hay movimientos. Con filas en
                     pantalla (una búsqueda) la grilla queda hasta que llegan los resultados. -->
                <v2:EstadoCargando x:Name="IndicadorCarga" DockPanel.Dock="Top" Texto="Cargando movimientos…">
                    <v2:EstadoCargando.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Cargando" />
                            <Binding Path="Items.Count" Converter="{x:Static conv:ConteoConverter.EsCero}" />
                        </MultiBinding>
                    </v2:EstadoCargando.IsVisible>
                </v2:EstadoCargando>

                <!-- UseLayoutRounding False: el estado vacío va centrado y el ancho del título es fraccionario; Avalonia
                     redondea su origen a píxel entero y Chromium no (mismo arreglo que en Productos). -->
                <v2:EstadoVacio x:Name="EstadoSinMovimientos"
                                UseLayoutRounding="False"
                                DockPanel.Dock="Top"
                                Titulo="No hay movimientos"
                                Mensaje="Probá con otros filtros o con otras fechas.">
                    <v2:EstadoVacio.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Cargando" Converter="{x:Static BoolConverters.Not}" />
                            <Binding Path="SinPermiso" Converter="{x:Static BoolConverters.Not}" />
                            <Binding Path="Items.Count" Converter="{x:Static conv:ConteoConverter.EsCero}" />
                        </MultiBinding>
                    </v2:EstadoVacio.IsVisible>
                </v2:EstadoVacio>

                <!-- Las diez columnas no entran a 1280 ni a 1366: la grilla scrollea en horizontal y las medidas quedan
                     con su texto entero (nunca se corta una medida si igual va a haber scroll). Columnas de plantilla
                     para que cada texto tenga elipsis y tooltip solo si se corta; SortMemberPath conserva el orden por
                     click. FECHA, TIPO, CANTIDAD, STOCK ANT., MOTIVO, PRECIO y USUARIO miden su texto sobre TODAS las
                     filas al cargar (b:ColumnaAuto) con el mismo conversor que la celda; STOCK NUEVO fija 220 y
                     PRODUCTO y COMENTARIO se reparten el resto con piso. CANTIDAD y PRECIO conservan MinWidth 100: con
                     números cortos la columna no baja de ahí. Separadores: los dibuja el tema v2. -->
                <DataGrid x:Name="Grilla"
                          ItemsSource="{Binding ItemsView}"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}">
                    <DataGrid.Columns>
                        <!-- FECHA como plantilla con un conversor a texto: la medición y el corte necesitan el texto
                             pintado, que un StringFormat sobre la fecha no le da a ColumnaAuto. Ordena por la fecha. -->
                        <DataGridTemplateColumn Header="FECHA" Width="Auto" SortMemberPath="Fecha"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:FechaHoraLocalConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="2*" SortMemberPath="ProductoNombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding ProductoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding ProductoNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TIPO" Width="Auto" SortMemberPath="TipoNombre" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding TipoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding TipoNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CANTIDAD" Width="Auto" MinWidth="100" CellStyleClasses="num" SortMemberPath="Cantidad"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:CantidadConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Cantidad, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Cantidad, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STOCK ANT." Width="Auto" CellStyleClasses="num" SortMemberPath="StockAnterior"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:CantidadConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <!-- Negativo: solo el número en rojo (token, nunca Opacity); la insignia va en STOCK NUEVO. -->
                                    <TextBlock Text="{Binding StockAnterior, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               Classes.negativo="{Binding StockAnterior, Converter={x:Static conv:EsNegativoConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding StockAnterior, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STOCK NUEVO" Width="220" MinWidth="100" CellStyleClasses="num" SortMemberPath="StockNuevo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <!-- Ancho FIJO 220 y una sola Grid con la insignia a la izquierda y el número a la
                                         derecha: la grilla recicla las celdas al ordenar y un contenedor que dependía de la
                                         visibilidad de la insignia dejaba el número corrido o recortado. 220 = peor caso
                                         "-99999,5" con la insignia. -->
                                    <Grid VerticalAlignment="Center">
                                        <v2:Insignia Texto="Stock negativo"
                                                     Variante="Peligro"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="{Binding StockNuevo, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                        <TextBlock Text="{Binding StockNuevo, Converter={x:Static conv:CantidadConverter.Instance}}"
                                                   Classes.negativo="{Binding StockNuevo, Converter={x:Static conv:EsNegativoConverter.Instance}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MOTIVO" Width="Auto" SortMemberPath="MotivoNombre" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding MotivoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding MotivoNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- PRECIO "—" cuando es 0: el servicio guarda 0 cuando el precio no aplica (toda salida y las
                             entradas sin precio) y "$ 0,00" se leería como "costó cero". -->
                        <DataGridTemplateColumn Header="PRECIO" Width="Auto" MinWidth="100" CellStyleClasses="num" SortMemberPath="PrecioUnitario"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:MonedaOGuionConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding PrecioUnitario, Converter={x:Static conv:MonedaOGuionConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding PrecioUnitario, Converter={x:Static conv:MonedaOGuionConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USUARIO" Width="Auto" SortMemberPath="UsuarioNombre" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding UsuarioNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding UsuarioNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="COMENTARIO" Width="3*" SortMemberPath="Comentario">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Comentario}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Comentario}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </v2:TarjetaContenido>
    </DockPanel>

</UserControl>
