<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Movimientos"
             xmlns:dto="using:StockApp.Application.Movimientos"
             xmlns:cat="using:StockApp.Application.Catalogo"
             xmlns:beh="using:StockApp.Presentation.Behaviors"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
             x:Class="StockApp.Presentation.Views.Movimientos.MovimientoHistorialView"
             x:DataType="vm:MovimientoHistorialViewModel">

    <Grid>
    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="MOVIMIENTOS" Titulo="Historial de movimientos">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <!-- "Recalcular stock": oculto sin Permisos.RecalcularStock (bugfix 2026-08-16,
                     ver MovimientoHistorialViewModel.PuedeRecalcularStock). Cada control conserva
                     su propio IsVisible textual (Task 6.3), no se consolido en uno solo. -->
                <!-- Bugfix 2026-08-19: el NumericUpDown pedia el ID (PK) del producto a mano, un
                     dato que no se muestra en ninguna vista de la app. Se reemplaza por un
                     AutoCompleteBox con búsqueda SERVER-SIDE (AsyncPopulator ->
                     MovimientoHistorialViewModel.BuscarProductosAsync ->
                     IProductoService.BuscarPorTextoAsync, ILIKE sobre Codigo/CodigoBarras/
                     Nombre). FilterMode="None" para no reaplicar un filtro client-side de
                     "empieza con" sobre resultados que el servidor ya matcheo por SKU/código de
                     barras (no solo por nombre). -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding PuedeRecalcularStock}">
                    <TextBlock Text="Producto a recalcular:" VerticalAlignment="Center" />
                    <AutoCompleteBox Width="220"
                                      PlaceholderText="Buscar producto..."
                                      AsyncPopulator="{Binding BuscarProductosAsync}"
                                      SelectedItem="{Binding ProductoSeleccionadoParaRecalcular}"
                                      ValueMemberBinding="{Binding Nombre, DataType={x:Type cat:ProductoDto}}"
                                      FilterMode="None"
                                      MinimumPopulateDelay="0:0:0.3">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="cat:ProductoDto">
                                <TextBlock Text="{Binding Nombre}" />
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </StackPanel>
                <Button Classes="secondary"
                        Content="Recalcular stock"
                        Command="{Binding RecalcularCommand}"
                        IsVisible="{Binding PuedeRecalcularStock}" />
            </StackPanel>
        </c:HeaderVista>

        <Border Classes="card">
            <Grid RowDefinitions="Auto,*">

                <!-- Barra de filtros -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- Filtro por producto: oculto si no hay GestionarProductos en la sesion,
                         o si una busqueda real choca con un 403 del servidor (bugfix 2026-08-16
                         + evolucion 2026-08-19, ver PuedeFiltrarPorProducto) - a diferencia de
                         Entrada/Salida e Ingreso por factura, este filtro es OPCIONAL, asi que
                         el resto del historial sigue siendo usable sin GestionarProductos.
                         Migrado de ComboBox con precarga completa a AutoCompleteBox con
                         busqueda server-side (mismo motivo que "Producto a recalcular" mas
                         arriba): sin seleccion = "Todos" (no hay opcion "Todos" explicita, ver
                         OnProductoFiltroSeleccionadoChanged). -->
                    <StackPanel Spacing="{DynamicResource Espacio1}" Margin="0,0,12,8" IsVisible="{Binding PuedeFiltrarPorProducto}">
                        <TextBlock Text="Producto" Classes="caption" />
                        <AutoCompleteBox MinWidth="180"
                                          PlaceholderText="Todos"
                                          AsyncPopulator="{Binding BuscarProductosParaFiltroAsync}"
                                          SelectedItem="{Binding ProductoFiltroSeleccionado}"
                                          ValueMemberBinding="{Binding Nombre, DataType={x:Type cat:ProductoDto}}"
                                          FilterMode="None"
                                          MinimumPopulateDelay="0:0:0.3">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="cat:ProductoDto">
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="Tipo" Classes="caption" />
                        <ComboBox ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoFiltroSeleccionado}"
                                  MinWidth="140">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="Desde" Classes="caption" />
                        <CalendarDatePicker SelectedDate="{Binding FechaDesde}"
                                            PlaceholderText="dd/mm/aaaa"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            beh:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="Hasta" Classes="caption" />
                        <CalendarDatePicker SelectedDate="{Binding FechaHasta}"
                                            PlaceholderText="dd/mm/aaaa"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            beh:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
                    </StackPanel>

                    <StackPanel Spacing="4" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Classes="primary"
                                Content="Buscar"
                                Command="{Binding BuscarCommand}" />
                    </StackPanel>
                </WrapPanel>

                <!-- Listado -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ItemsView}"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, Converter={x:Static conv:FechaUtcALocalConverter.Instance}, StringFormat='dd/MM/yyyy HH:mm', DataType={x:Type dto:MovimientoHistorialDto}}" Width="Auto" />
                        <DataGridTemplateColumn Header="Producto" Width="2*" SortMemberPath="ProductoNombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding ProductoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding ProductoNombre}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoNombre, DataType={x:Type dto:MovimientoHistorialDto}}" Width="Auto" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoNombre, DataType={x:Type dto:MovimientoHistorialDto}}" Width="Auto" />
                        <DataGridTextColumn Header="Cantidad"
                                             Binding="{Binding Cantidad, Converter={x:Static conv:CantidadConverter.Instance}, DataType={x:Type dto:MovimientoHistorialDto}}"
                                             Width="Auto" MinWidth="100" CellStyleClasses="num" />
                        <DataGridTextColumn Header="Precio"
                                             Binding="{Binding PrecioUnitario, Converter={x:Static conv:MonedaConverter.Instance}, DataType={x:Type dto:MovimientoHistorialDto}}"
                                             Width="Auto" MinWidth="100" CellStyleClasses="num" />
                        <DataGridTemplateColumn Header="Stock ant." Width="Auto" MinWidth="100" SortMemberPath="StockAnterior">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding StockAnterior, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               Foreground="{Binding StockAnterior, Converter={x:Static conv:SignoNegativoBrushConverter.Instance}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Stock nuevo" Width="Auto" MinWidth="100" SortMemberPath="StockNuevo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio1}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0">
                                        <c:BadgeEstado Texto="Stock negativo" Tono="Peligro"
                                                       IsVisible="{Binding StockNuevo, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                        <TextBlock Text="{Binding StockNuevo, Converter={x:Static conv:CantidadConverter.Instance}}"
                                                   Foreground="{Binding StockNuevo, Converter={x:Static conv:SignoNegativoBrushConverter.Instance}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre, DataType={x:Type dto:MovimientoHistorialDto}}" Width="Auto" />
                        <DataGridTemplateColumn Header="Comentario" Width="3*" SortMemberPath="Comentario">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Comentario}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Comentario}"
                                               VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </DockPanel>

        <!-- bugfix "pantalla muda ante un 403": ver ViewModelBase.EjecutarCargaProtegidaAsync. -->
        <c:EstadoVacio Titulo="Sin permiso"
                       Mensaje="{Binding MensajeSinPermiso}"
                       EsError="True"
                       IsVisible="{Binding SinPermiso}" />
    </Grid>

</UserControl>
