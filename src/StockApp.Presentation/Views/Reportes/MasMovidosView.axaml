<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Reportes"
             xmlns:dto="using:StockApp.Application.Reportes"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.MasMovidosView"
             x:DataType="vm:MasMovidosViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/reportes/. Pantalla de consulta: sin botón primario. La estructura común (breadcrumb al hub,
         estados de carga, sin conexión, sin permiso y vacío, pie) la da MarcoReporte. -->
    <DockPanel Margin="28,24">
        <r:MarcoReporte x:Name="Marco" Titulo="Productos más movidos"
                        VolverCommand="{Binding VolverCommand}"
                        HayDatos="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}"
                        TituloVacio="{Binding TituloVacio}"
                        MensajeVacio="{Binding MensajeVacio}"
                        MensajeError="{Binding MensajeError}">

            <r:MarcoReporte.Acciones>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BotonExportarPdf" Classes="secundario" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                </StackPanel>
            </r:MarcoReporte.Acciones>

            <r:MarcoReporte.Filtros>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <v2:CampoFormulario Etiqueta="Desde">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaDesde}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Hasta">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaHasta}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Top">
                        <NumericUpDown x:Name="CampoTop" Value="{Binding TopN}" Minimum="1" Width="100" FormatString="0" Increment="1" />
                    </v2:CampoFormulario>
                    <Button x:Name="BotonBuscar" Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" />
                </StackPanel>
            </r:MarcoReporte.Filtros>

            <r:MarcoReporte.Contenido>
                <DataGrid x:Name="Grilla" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CÓDIGO" SortMemberPath="Codigo" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MasMovidoDto">
                                    <TextBlock Text="{Binding Codigo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Codigo}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NOMBRE" SortMemberPath="Nombre" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MasMovidoDto">
                                    <TextBlock Text="{Binding Nombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Nombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MOVIMIENTOS" SortMemberPath="CantidadMovimientos" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MasMovidoDto">
                                    <TextBlock Text="{Binding CantidadMovimientos}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VOLUMEN TOTAL" SortMemberPath="VolumenTotal" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:CantidadConverter.Instance}" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MasMovidoDto">
                                    <TextBlock Text="{Binding VolumenTotal, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </r:MarcoReporte.Contenido>

            <r:MarcoReporte.Pie>
                <TextBlock x:Name="PieConteo" Classes="pie-conteo"
                           Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='producto|productos'}" />
            </r:MarcoReporte.Pie>
        </r:MarcoReporte>
    </DockPanel>
</UserControl>
