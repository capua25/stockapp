<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Reportes"
             xmlns:dto="using:StockApp.Application.Movimientos"
             xmlns:cat="using:StockApp.Application.Catalogo"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.HistorialPorProductoView"
             x:DataType="vm:HistorialPorProductoViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/reportes/. Pantalla de consulta: sin botón primario. La estructura común (breadcrumb al hub,
         estados de carga, sin conexión, sin permiso y vacío, pie) la da MarcoReporte. -->
    <DockPanel Margin="28,24">
        <r:MarcoReporte x:Name="Marco" Titulo="Historial por producto"
                        VolverCommand="{Binding VolverCommand}"
                        HayDatos="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}"
                        TituloVacio="{Binding TituloVacio}"
                        MensajeVacio="{Binding MensajeVacio}"
                        MensajeError="{Binding MensajeError}">

            <r:MarcoReporte.Acciones>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BotonExportarPdf" Classes="secundario" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                </StackPanel>
            </r:MarcoReporte.Acciones>

            <r:MarcoReporte.Filtros>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <v2:CampoFormulario x:Name="CampoProducto" Etiqueta="Producto">
                        <AutoCompleteBox x:Name="BuscadorProducto" Width="280" PlaceholderText="Buscar producto…"
                                         AsyncPopulator="{Binding BuscarProductosAsync}"
                                         SelectedItem="{Binding ProductoSeleccionado}"
                                         ValueMemberBinding="{Binding Nombre, DataType={x:Type cat:ProductoDto}}"
                                         FilterMode="None" MinimumPopulateDelay="0:0:0.3">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="cat:ProductoDto">
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Desde">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaDesde}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Hasta">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaHasta}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <Button x:Name="BotonBuscar" Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" />
                </StackPanel>
            </r:MarcoReporte.Filtros>

            <r:MarcoReporte.Contenido>
                <DataGrid x:Name="Grilla" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FECHA" SortMemberPath="Fecha" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:FechaHoraLocalConverter.Instance}" b:ColumnaAuto.NoCede="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TIPO" SortMemberPath="TipoNombre" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding TipoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding TipoNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="MOTIVO" SortMemberPath="MotivoNombre" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding MotivoNombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding MotivoNombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CANTIDAD" SortMemberPath="Cantidad" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:CantidadConverter.Instance}" MinWidth="100" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Cantidad, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="P. UNITARIO" SortMemberPath="PrecioUnitario" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:MonedaOGuionConverter.Instance}" MinWidth="100" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding PrecioUnitario, Converter={x:Static conv:MonedaOGuionConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding PrecioUnitario, Converter={x:Static conv:MonedaOGuionConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STOCK ANT." SortMemberPath="StockAnterior" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:CantidadConverter.Instance}" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding StockAnterior, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               Classes.negativo="{Binding StockAnterior, Converter={x:Static conv:EsNegativoConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding StockAnterior, Converter={x:Static conv:CantidadConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STOCK NUEVO" SortMemberPath="StockNuevo" Width="220" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <Grid VerticalAlignment="Center">
                                        <v2:Insignia Texto="Stock negativo" Variante="Peligro" HorizontalAlignment="Left"
                                                     IsVisible="{Binding StockNuevo, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                        <TextBlock Text="{Binding StockNuevo, Converter={x:Static conv:CantidadConverter.Instance}}"
                                                   Classes.negativo="{Binding StockNuevo, Converter={x:Static conv:EsNegativoConverter.Instance}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="COMENTARIO" SortMemberPath="Comentario" Width="*" b:DataGridColumnasAutoBehavior.PisoProporcional="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MovimientoHistorialDto">
                                    <TextBlock Text="{Binding Comentario}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Comentario}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </r:MarcoReporte.Contenido>

            <r:MarcoReporte.Pie>
                <TextBlock x:Name="PieConteo" Classes="pie-conteo"
                           Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='movimiento|movimientos'}" />
            </r:MarcoReporte.Pie>
        </r:MarcoReporte>
    </DockPanel>
</UserControl>
