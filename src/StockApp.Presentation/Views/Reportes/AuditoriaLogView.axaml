<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Reportes"
             xmlns:dto="using:StockApp.Application.Auditoria"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.AuditoriaLogView"
             x:DataType="vm:AuditoriaLogViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/reportes/. Pantalla de consulta: sin botón primario. La estructura común (breadcrumb al hub,
         estados de carga, sin conexión, sin permiso y vacío, pie) la da MarcoReporte. -->
    <DockPanel Margin="28,24">
        <r:MarcoReporte x:Name="Marco" Titulo="Log de auditoría"
                        VolverCommand="{Binding VolverCommand}"
                        HayDatos="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}"
                        TituloVacio="{Binding TituloVacio}"
                        MensajeVacio="{Binding MensajeVacio}"
                        MensajeError="{Binding MensajeError}">

            <r:MarcoReporte.Acciones>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BotonExportarPdf" Classes="secundario" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                </StackPanel>
            </r:MarcoReporte.Acciones>

            <r:MarcoReporte.Filtros>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <v2:CampoFormulario x:Name="CampoUsuario" Etiqueta="Usuario" IsVisible="{Binding PuedeFiltrarPorUsuario}">
                        <ComboBox x:Name="ComboUsuario" Width="200" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioFiltroSeleccionado}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpcionUsuario">
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Desde">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaDesde}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Hasta">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaHasta}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <Button x:Name="BotonBuscar" Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" />
                </StackPanel>
            </r:MarcoReporte.Filtros>

            <r:MarcoReporte.Contenido>
                <DataGrid x:Name="Grilla" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FECHA" SortMemberPath="Fecha" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:FechaHoraLocalConverter.Instance}" b:ColumnaAuto.NoCede="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Fecha, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USUARIO" SortMemberPath="NombreUsuario" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding NombreUsuario}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding NombreUsuario}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACCIÓN" SortMemberPath="Accion" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static r:AccionAuditadaConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding Accion, Converter={x:Static r:AccionAuditadaConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Accion, Converter={x:Static r:AccionAuditadaConverter.Instance}}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ENTIDAD" SortMemberPath="Entidad" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding Entidad}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Entidad}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ENTIDAD ID" SortMemberPath="EntidadId" Width="Auto" b:ColumnaAuto.Medir="True" MinWidth="80" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding EntidadId}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DETALLE" SortMemberPath="Detalle" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:AuditoriaItemDto">
                                    <TextBlock Text="{Binding Detalle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Detalle}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </r:MarcoReporte.Contenido>

            <r:MarcoReporte.Pie>
                <TextBlock x:Name="PieConteo" Classes="pie-conteo"
                           Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='registro|registros'}" />
            </r:MarcoReporte.Pie>
        </r:MarcoReporte>
    </DockPanel>
</UserControl>
