<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Reportes"
             xmlns:dto="using:StockApp.Application.Reportes"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.ValorizacionView"
             x:DataType="vm:ValorizacionViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/reportes/. Pantalla de consulta: sin botón primario. La estructura común (breadcrumb al hub,
         estados de carga, sin conexión, sin permiso y vacío, pie) la da MarcoReporte. -->
    <DockPanel Margin="28,24">
        <r:MarcoReporte x:Name="Marco" Titulo="Valorización de inventario"
                        VolverCommand="{Binding VolverCommand}"
                        HayDatos="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}"
                        TituloVacio="{Binding TituloVacio}"
                        MensajeVacio="{Binding MensajeVacio}">

            <r:MarcoReporte.Acciones>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BotonActualizar" Classes="secundario" Content="Actualizar" Command="{Binding BuscarCommand}" />
                    <Button x:Name="BotonExportarPdf" Classes="secundario" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                </StackPanel>
            </r:MarcoReporte.Acciones>

            <r:MarcoReporte.Contenido>
                <DataGrid x:Name="Grilla" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CÓDIGO" SortMemberPath="Codigo" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <TextBlock Text="{Binding Codigo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Codigo}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NOMBRE" SortMemberPath="Nombre" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <TextBlock Text="{Binding Nombre}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Nombre}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CATEGORÍA" SortMemberPath="Categoria" Width="Auto" b:ColumnaAuto.Medir="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <TextBlock Text="{Binding Categoria}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Categoria}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STOCK" SortMemberPath="StockActual" Width="220" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <Grid VerticalAlignment="Center">
                                        <v2:Insignia Texto="Stock negativo" Variante="Peligro" HorizontalAlignment="Left"
                                                     IsVisible="{Binding StockActual, Converter={x:Static conv:EsNegativoConverter.Instance}}" />
                                        <TextBlock Text="{Binding StockActual, Converter={x:Static conv:CantidadConverter.Instance}}"
                                                   Classes.negativo="{Binding StockActual, Converter={x:Static conv:EsNegativoConverter.Instance}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="P. COSTO" SortMemberPath="PrecioCosto" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:MonedaConverter.Instance}" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <TextBlock Text="{Binding PrecioCosto, Converter={x:Static conv:MonedaConverter.Instance}}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VALOR COSTO" SortMemberPath="ValorCosto" Width="Auto" b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:MonedaConverter.Instance}" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:ValorizacionItemDto">
                                    <TextBlock Text="{Binding ValorCosto, Converter={x:Static conv:MonedaConverter.Instance}}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </r:MarcoReporte.Contenido>

            <r:MarcoReporte.Pie>
                <Grid>
                    <TextBlock x:Name="PieConteo" Classes="pie-conteo" VerticalAlignment="Center"
                               Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='producto|productos'}" />
                    <StackPanel x:Name="PieTotal" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Classes="etiqueta-campo" Text="Total valor costo" VerticalAlignment="Center" />
                        <TextBlock Classes="titulo-seccion" FontFeatures="+tnum,-calt" Text="{Binding Totales.TotalValorCosto, Converter={x:Static conv:MonedaConverter.Instance}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </r:MarcoReporte.Pie>
        </r:MarcoReporte>
    </DockPanel>
</UserControl>
