<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.MarcoReporte"
             x:DataType="vm:ViewModelBase">

    <!-- Marco común de los seis reportes (local de la fase, no es del tema): breadcrumb "Reportes / título" que vuelve al hub,
         acciones, filtros opcionales, alerta de error, los estados de carga, sin conexión, sin permiso y vacío, el contenido
         (la grilla) y el pie. Toma los estados de ViewModelBase por el DataContext del reporte; la vista solo le dice si hay
         datos (HayDatos). Sin permiso reemplaza a la card; el resto va dentro de ella con los filtros a mano. -->
    <DockPanel>

        <v2:EncabezadoPagina x:Name="Encabezado" DockPanel.Dock="Top"
                             BreadcrumbOrigen="Reportes"
                             BreadcrumbComando="{Binding $parent[r:MarcoReporte].VolverCommand}"
                             BreadcrumbActual="{Binding $parent[r:MarcoReporte].Titulo}"
                             Titulo="{Binding $parent[r:MarcoReporte].Titulo}"
                             Acciones="{Binding $parent[r:MarcoReporte].Acciones}" />

        <v2:EstadoVacio x:Name="EstadoSinPermiso" DockPanel.Dock="Top" UseLayoutRounding="False"
                        Titulo="Sin permiso" Mensaje="{Binding MensajeSinPermiso}" EsError="True"
                        IsVisible="{Binding SinPermiso}" />

        <v2:TarjetaContenido x:Name="Tarjeta" IsVisible="{Binding !SinPermiso}">
            <DockPanel>
                <v2:BarraFiltros x:Name="BarraDeFiltros" DockPanel.Dock="Top" MostrarBusqueda="False"
                                 IsVisible="{Binding $parent[r:MarcoReporte].Filtros, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding $parent[r:MarcoReporte].Filtros}" />
                </v2:BarraFiltros>

                <v2:Alerta x:Name="AlertaError" DockPanel.Dock="Top" Margin="0,0,0,12" Variante="Error"
                           Texto="{Binding $parent[r:MarcoReporte].MensajeError}"
                           IsVisible="{Binding $parent[r:MarcoReporte].MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <ContentControl x:Name="ZonaPie" DockPanel.Dock="Bottom" Margin="0,12,0,0"
                                Content="{Binding $parent[r:MarcoReporte].Pie}">
                    <ContentControl.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="$parent[r:MarcoReporte].HayDatos" />
                            <Binding Path="SinConexion" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </ContentControl.IsVisible>
                </ContentControl>

                <v2:EstadoCargando x:Name="IndicadorCarga" DockPanel.Dock="Top" Texto="Cargando reporte…">
                    <v2:EstadoCargando.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Cargando" />
                            <Binding Path="$parent[r:MarcoReporte].HayDatos" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </v2:EstadoCargando.IsVisible>
                </v2:EstadoCargando>

                <v2:EstadoVacio x:Name="EstadoSinConexion" DockPanel.Dock="Top" UseLayoutRounding="False"
                                Titulo="No se pudo conectar con el servidor"
                                Mensaje="Verificá que el servidor esté encendido y accesible en la red, y volvé a intentar."
                                EsError="True" IsVisible="{Binding SinConexion}">
                    <Button x:Name="BotonReintentar" Classes="secundario" Content="Reintentar" Command="{Binding ReintentarCargaCommand}" />
                </v2:EstadoVacio>

                <v2:EstadoVacio x:Name="EstadoVacio" DockPanel.Dock="Top" UseLayoutRounding="False"
                                Titulo="{Binding $parent[r:MarcoReporte].TituloVacio}"
                                Mensaje="{Binding $parent[r:MarcoReporte].MensajeVacio}">
                    <v2:EstadoVacio.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Cargando" Converter="{x:Static BoolConverters.Not}" />
                            <Binding Path="SinPermiso" Converter="{x:Static BoolConverters.Not}" />
                            <Binding Path="SinConexion" Converter="{x:Static BoolConverters.Not}" />
                            <Binding Path="$parent[r:MarcoReporte].HayDatos" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </v2:EstadoVacio.IsVisible>
                </v2:EstadoVacio>

                <ContentControl x:Name="ZonaContenido" Content="{Binding $parent[r:MarcoReporte].Contenido}">
                    <ContentControl.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="$parent[r:MarcoReporte].HayDatos" />
                            <Binding Path="SinConexion" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </ContentControl.IsVisible>
                </ContentControl>
            </DockPanel>
        </v2:TarjetaContenido>
    </DockPanel>
</UserControl>
