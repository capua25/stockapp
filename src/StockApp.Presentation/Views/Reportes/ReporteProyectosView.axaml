<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Reportes"
             xmlns:dto="using:StockApp.Application.Reportes"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:r="using:StockApp.Presentation.Views.Reportes"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Reportes.ReporteProyectosView"
             x:DataType="vm:ReporteProyectosViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- UI v2. Espejo: docs/ui-v2/mockups/reportes/. Pantalla de consulta: sin botón primario. La estructura común (breadcrumb al hub,
         estados de carga, sin conexión, sin permiso y vacío, pie) la da MarcoReporte. -->
    <DockPanel Margin="28,24">
        <r:MarcoReporte x:Name="Marco" Titulo="Estadística de proyectos"
                        VolverCommand="{Binding VolverCommand}"
                        HayDatos="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.HayElementos}}"
                        TituloVacio="{Binding TituloVacio}"
                        MensajeVacio="{Binding MensajeVacio}"
                        MensajeError="{Binding MensajeError}">

            <r:MarcoReporte.Acciones>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BotonExportarPdf" Classes="secundario" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                </StackPanel>
            </r:MarcoReporte.Acciones>

            <r:MarcoReporte.Filtros>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <v2:CampoFormulario Etiqueta="Agrupar por">
                        <ComboBox x:Name="ComboAgrupador" Width="220" ItemsSource="{Binding AgrupadoresDisponibles}" SelectedItem="{Binding AgrupadorSeleccionado}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpcionAgrupador">
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Contar por">
                        <ComboBox x:Name="ComboCriterio" Width="180" ItemsSource="{Binding CriteriosDisponibles}" SelectedItem="{Binding CriterioOpcionSeleccionada}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpcionCriterio">
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Desde">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaDesde}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <v2:CampoFormulario Etiqueta="Hasta">
                <CalendarDatePicker Width="140" SelectedDate="{Binding FechaHasta}" PlaceholderText="dd/mm/aaaa"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                    b:CalendarDatePickerFechaBehavior.NormalizarFechaTipeada="True" />
            </v2:CampoFormulario>
                    <Button x:Name="BotonBuscar" Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" />
                </StackPanel>
            </r:MarcoReporte.Filtros>

            <r:MarcoReporte.Contenido>
                <DockPanel>
                    <v2:Alerta x:Name="AlertaCriterioCierre" DockPanel.Dock="Top" Margin="0,0,0,12" Variante="Advertencia"
                               Texto="Criterio 'Fecha de cierre': solo se cuentan proyectos Terminados o Cancelados. Las columnas 'Pendientes' y 'En curso' muestran 0 a propósito, no faltan datos."
                               IsVisible="{Binding EsCriterioCierre}" />
                <DataGrid x:Name="Grilla" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CLASIFICADOR" SortMemberPath="Clasificador" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding Clasificador}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Clasificador}"
                                               b:TooltipSiSeCorta.Activo="True"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PENDIENTES" SortMemberPath="Pendientes" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding Pendientes}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="EN CURSO" SortMemberPath="EnCurso" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding EnCurso}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TERMINADOS" SortMemberPath="Terminados" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding Terminados}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CANCELADOS" SortMemberPath="Cancelados" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding Cancelados}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TOTAL" SortMemberPath="Total" Width="Auto" b:ColumnaAuto.Medir="True" CellStyleClasses="num">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:FilaReporteProyectos">
                                    <TextBlock Text="{Binding Total}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </r:MarcoReporte.Contenido>

            <r:MarcoReporte.Pie>
                <Grid>
                    <TextBlock x:Name="PieConteo" Classes="pie-conteo" VerticalAlignment="Center"
                               Text="{Binding Items.Count, Converter={x:Static conv:ConteoConverter.Instance}, ConverterParameter='fila|filas'}" />
                    <StackPanel x:Name="PieTotalGeneral" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Classes="etiqueta-campo" Text="Total general" VerticalAlignment="Center" />
                        <TextBlock Classes="titulo-seccion" FontFeatures="+tnum,-calt" Text="{Binding TotalGeneral}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </r:MarcoReporte.Pie>
        </r:MarcoReporte>
    </DockPanel>
</UserControl>
