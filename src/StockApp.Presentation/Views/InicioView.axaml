<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:tareasvm="using:StockApp.Presentation.ViewModels.Tareas"
             xmlns:convA="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="StockApp.Presentation.Views.InicioView"
             x:DataType="vm:InicioViewModel">

    <Grid>

        <Image Source="avares://StockApp.Presentation/Assets/carmelo-original.png"
               Opacity="0.28"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransform="scale(0.85)" />

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="20">

            <!-- Encabezado -->
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Saludo}"
                               Classes="titulo-vista" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Sesión iniciada como"
                                   FontSize="14"
                                   Opacity="0.6" />
                        <TextBlock Text="{Binding RolTexto}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Aviso de vencimientos: gateado por PuedeVerCalendarioPagos ademas de
                 MostrarAvisoVencimientos. El fix del bug 2026-08-15 evita la LLAMADA a
                 /finanzas/calendario-pagos sin VerFinanzas, pero el panel tambien debe
                 desaparecer explicitamente (no solo quedar en cero por la falta de datos). -->
            <Border Classes="card">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static convA:BoolConverters.And}">
                        <Binding Path="PuedeVerCalendarioPagos" />
                        <Binding Path="MostrarAvisoVencimientos" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="8">
                    <TextBlock Text="Vencimientos de facturas" Classes="seccion" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding TextoVencidas}"
                               IsVisible="{Binding CantidadVencidas}" />
                    <TextBlock Text="{Binding TextoAVencer7Dias}"
                               IsVisible="{Binding CantidadAVencer7Dias}" />
                    <Button Content="Ver calendario de pagos" Command="{Binding IrACalendarioPagosCommand}" />
                </StackPanel>
            </Border>

            <!-- Panel "Tareas que requieren atención" (spec 2026-08-06): oculto por completo
                 cuando no hay ninguna tarea vencida ni próxima a vencer (MostrarPanelTareas),
                 nunca un cartel vacío. Cada fila es un Button entero (no solo un "Ver" aparte):
                 toda la fila es clickeable y navega al detalle vía VerTareaCommand. Gateado
                 ademas por PuedeVerTareas (fix del bug 2026-08-15): sin Permisos.GestionarTareas
                 el panel tambien debe desaparecer explicitamente, no solo quedar en cero. -->
            <Border Classes="card" x:Name="BorderPanelTareas">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static convA:BoolConverters.And}">
                        <Binding Path="PuedeVerTareas" />
                        <Binding Path="MostrarPanelTareas" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="12">
                    <TextBlock Text="Tareas que requieren atención" Classes="seccion" />

                    <StackPanel Spacing="8" IsVisible="{Binding MostrarSeccionTareasVencidas}">
                        <TextBlock Text="{Binding TituloVencidas}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <ItemsControl ItemsSource="{Binding TareasVencidas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tareasvm:TareaFila">
                                    <Button Classes="ghost"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((vm:InicioViewModel)DataContext).VerTareaCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="●"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Titulo}" />
                                            <TextBlock Grid.Column="2" Text="{Binding TextoDiasParaVencer}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Margin="8,0" />
                                            <TextBlock Grid.Column="3" Text="→" Opacity="0.6" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding MostrarSeccionTareasProximasAVencer}">
                        <TextBlock Text="{Binding TituloProximasAVencer}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding TareasProximasAVencer}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tareasvm:TareaFila">
                                    <Button Classes="ghost"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((vm:InicioViewModel)DataContext).VerTareaCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="○" Margin="0,0,8,0" Opacity="0.6" />
                                            <TextBlock Grid.Column="1" Text="{Binding Titulo}" />
                                            <TextBlock Grid.Column="2" Text="{Binding TextoDiasParaVencer}"
                                                       Margin="8,0" Opacity="0.7" />
                                            <TextBlock Grid.Column="3" Text="→" Opacity="0.6" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Classes="ghost"
                            Content="Ver todas las tareas →"
                            HorizontalAlignment="Right"
                            Command="{Binding VerTodasLasTareasCommand}" />
                </StackPanel>
            </Border>

            <!-- Aviso de salud de backup: condición de FALLA/RIESGO (no informativa como
                 vencimientos), por eso usa borde DangerBrush además del título en rojo — debe
                 leerse como más urgente que el aviso de vencimientos de arriba. -->
            <Border Classes="card"
                    x:Name="BorderAvisoBackupProblema"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding MostrarAvisoBackupProblema}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup de la base de datos" Classes="seccion" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding TextoAvisoBackup}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Tercer estado (review final E1): no se pudo VERIFICAR la salud del backup (API
                 caída, 403, 404 por una versión vieja del servidor, cambio de forma del JSON) —
                 NO es lo mismo que "backup vencido" (arriba, rojo) ni que "backup al día"
                 (sin aviso). Usa WarningBrush (ámbar) para no confundirse visualmente con una
                 falla confirmada: nunca hay que ocultar en silencio un fallo de consulta. -->
            <Border Classes="card"
                    x:Name="BorderAvisoBackupDesconocido"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding MostrarAvisoBackupDesconocido}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup de la base de datos" Classes="seccion" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding TextoAvisoBackup}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Accesos rápidos -->
            <Border Classes="card">
                <StackPanel Spacing="12">

                    <TextBlock Text="Accesos rápidos"
                               Classes="seccion" />

                    <WrapPanel>

                        <Button x:Name="BotonAccesoProductos"
                                Command="{Binding IrAProductosCommand}"
                                IsVisible="{Binding PuedeGestionarProductos}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Productos"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Ver y administrar el catálogo"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BotonAccesoRegistrarEntrada"
                                Command="{Binding IrARegistrarEntradaCommand}"
                                IsVisible="{Binding PuedeRegistrarEntradaSalida}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Registrar Entrada"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Cargar entradas de stock"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BotonAccesoRegistrarSalida"
                                Command="{Binding IrARegistrarSalidaCommand}"
                                IsVisible="{Binding PuedeRegistrarEntradaSalida}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Registrar Salida"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Cargar salidas de stock"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BotonAccesoHistorialMovimientos"
                                Command="{Binding IrAHistorialMovimientosCommand}"
                                IsVisible="{Binding PuedeRegistrarMovimientos}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Historial de movimientos"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Consultar movimientos registrados"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding IrAValorizacionCommand}"
                                IsVisible="{Binding PuedeVerReportes}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Valorización de inventario"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Ver el valor total del stock"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding IrAAuditoriaCommand}"
                                IsVisible="{Binding PuedeVerReportes}"
                                Width="200"
                                Height="90"
                                Background="{DynamicResource FondoBrush}"
                                BorderBrush="{DynamicResource BordeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,12"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Log de auditoría"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Revisar la actividad del sistema"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Button>

                    </WrapPanel>

                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
