<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="StockApp.Presentation.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource FondoBrush}">

    <Grid>

        <Image Source="avares://StockApp.Presentation/Assets/carmelo-original.png"
               Opacity="0.28"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransform="scale(0.85)" />

        <Border Classes="card" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <StackPanel Spacing="16">

                <TextBlock Text="StockApp"
                           Classes="titulo-vista"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="Ingresá tus credenciales para continuar."
                           HorizontalAlignment="Center"
                           Opacity="0.7" />

                <!-- Modo acceso limitado (FIX 1, re-review final E1): avisa que este login,
                     al autenticar, va a Mantenimiento (solo backups) y no al sistema completo. -->
                <TextBlock Text="Modo de acceso limitado: la licencia está vencida. Solo vas a poder descargar backups."
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding SoloAccesoLimitado}" />

                <!-- Usuario -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Usuario" />
                    <TextBox Text="{Binding NombreUsuario}"
                             PlaceholderText="Nombre de usuario"
                             KeyDown="OnCampoKeyDown" />
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña" />
                    <TextBox Text="{Binding Contrasena}"
                             PasswordChar="●"
                             PlaceholderText="Contraseña"
                             KeyDown="OnCampoKeyDown" />
                </StackPanel>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- Botón -->
                <Button Content="Entrar"
                        Classes="primary"
                        Command="{Binding EntrarCommand}"
                        IsDefault="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <!-- Reset de Admin (Inc 7 Fase B): link discreto para el flujo de recuperación -->
                <Button Content="No puedo entrar / resetear Admin"
                        Command="{Binding ResetearAdminCommand}"
                        HorizontalAlignment="Center" />

                <!-- Versión de la app: discreta, al pie del formulario -->
                <TextBlock Text="{Binding VersionTexto}"
                           FontSize="11"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
