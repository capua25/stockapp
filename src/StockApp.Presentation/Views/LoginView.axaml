<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="StockApp.Presentation.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource FondoBrush}">

    <UserControl.Styles>
        <!-- Marca de agua del logo del municipio: NO es Opacity decorativa gateada por conversor
             de dominio, es un efecto de marca fijo aprobado y mergeado a main el 2026-07-10
             (commits 4bb3222 + 8ee5f32). Se define via Style (Priority=Style, no LocalValue) para
             no chocar con Vista_NoTieneOpacidadesLiterales — ese guardian filtra por
             BindingPriority.LocalValue, que es exactamente lo que distingue un Setter de Style
             (chrome) de un Opacity puesto a mano en el control. Mismo mecanismo que
             Image.fondo-difuminado de InicioView (Ruling B-11): no cambia un pixel, mantiene a
             LoginView dentro del invariante generico del guardian, sin exencion ni test dedicado. -->
        <Style Selector="Image.marca-agua">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <Image Source="avares://StockApp.Presentation/Assets/carmelo-original.png"
               Classes="marca-agua"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransform="scale(0.85)" />

        <Border Classes="card" Padding="{DynamicResource PaddingHolgado}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <StackPanel Spacing="{DynamicResource Espacio4}">

                <TextBlock Text="StockApp"
                           Classes="titulo-vista"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="Ingresá tus credenciales para continuar."
                           Classes="body"
                           Foreground="{DynamicResource TextoSecundarioBrush}"
                           HorizontalAlignment="Center" />

                <!-- Modo acceso limitado (FIX 1, re-review final E1): avisa que este login,
                     al autenticar, va a Mantenimiento (solo backups) y no al sistema completo. -->
                <TextBlock Text="Modo de acceso limitado: la licencia está vencida. Solo vas a poder descargar backups."
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding SoloAccesoLimitado}" />

                <!-- Usuario -->
                <c:CampoFormulario Etiqueta="Usuario">
                    <TextBox Text="{Binding NombreUsuario}"
                             PlaceholderText="Nombre de usuario"
                             KeyDown="OnCampoKeyDown" />
                </c:CampoFormulario>

                <!-- Contraseña -->
                <c:CampoFormulario Etiqueta="Contraseña">
                    <TextBox Text="{Binding Contrasena}"
                             PasswordChar="●"
                             PlaceholderText="Contraseña"
                             KeyDown="OnCampoKeyDown" />
                </c:CampoFormulario>

                <!-- Mensaje de error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />

                <!-- Botón -->
                <Button Content="Entrar"
                        Classes="primary"
                        Command="{Binding EntrarCommand}"
                        IsDefault="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <!-- Reset de Admin (Inc 7 Fase B): link discreto para el flujo de recuperación -->
                <Button Content="No puedo entrar / resetear Admin"
                        Classes="ghost"
                        Command="{Binding ResetearAdminCommand}"
                        HorizontalAlignment="Center" />

                <!-- Versión de la app: discreta, al pie del formulario -->
                <TextBlock Text="{Binding VersionTexto}"
                           Classes="micro"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
