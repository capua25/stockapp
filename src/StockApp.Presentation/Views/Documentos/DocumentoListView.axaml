<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Documentos"
             xmlns:c="using:StockApp.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StockApp.Presentation.Views.Documentos.DocumentoListView"
             x:DataType="vm:DocumentoListViewModel">

    <DockPanel Margin="{DynamicResource MargenVista}">

        <c:HeaderVista DockPanel.Dock="Top" Eyebrow="DOCUMENTOS" Titulo="Documentos administrativos">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espacio2}">
                <Button Classes="primary" Content="Nuevo documento" Command="{Binding NuevoCommand}" />
            </StackPanel>
        </c:HeaderVista>

        <TabControl x:Name="Solapas" SelectionChanged="OnSolapaSeleccionada">

            <TabItem Header="Activos">
                <DockPanel Margin="0,12,0,0">

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource Espacio3}"
                                VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <StackPanel MinWidth="150">
                            <c:CampoFormulario Etiqueta="Tipo">
                                <ComboBox ItemsSource="{Binding TiposDisponibles}"
                                          SelectedItem="{Binding FiltroActivosTipoSeleccionado}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nombre}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </c:CampoFormulario>
                        </StackPanel>
                        <StackPanel MinWidth="280">
                            <c:CampoFormulario Etiqueta="Buscar">
                                <TextBox Text="{Binding FiltroActivosTexto}"
                                         Watermark="Número, descripción..." />
                            </c:CampoFormulario>
                        </StackPanel>
                        <Button Classes="secondary" Content="Buscar" Command="{Binding BuscarActivosCommand}" />
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Activos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentoFila">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}/{2}">
                                                            <Binding Path="TipoTexto" />
                                                            <Binding Path="Numero" />
                                                            <Binding Path="Anio" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Descripcion}" Classes="caption" />
                                                <TextBlock Text="{Binding EstadoTexto}" Classes="caption" Foreground="{DynamicResource TextoTerciarioBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="ghost" Content="Ver"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).VerDetalleCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Classes="secondary" Content="Iniciar"
                                                    IsVisible="{Binding PuedeIniciar}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).IniciarCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Classes="secondary" Content="Volver a pendiente"
                                                    IsVisible="{Binding PuedeVolverAPendiente}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).VolverAPendienteCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="4" Classes="secondary" Content="Finalizar"
                                                    IsVisible="{Binding PuedeFinalizar}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).FinalizarCommand}"
                                                    CommandParameter="{Binding}" />
                                            <!-- I3: "Anular…" navega al detalle (VerDetalleCommand) en vez de ejecutar
                                                 la acción acá mismo, porque anular exige motivo obligatorio, y ese
                                                 flujo vive en DocumentoFormViewModel.AnularAsync. Los puntos
                                                 suspensivos marcan que el botón abre otra pantalla, no que anula
                                                 en el acto. -->
                                            <Button Grid.Column="5" Classes="danger" Content="Anular…"
                                                    IsVisible="{Binding PuedeAnular}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).VerDetalleCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Historial">
                <DockPanel Margin="0,12,0,0">

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource Espacio3}"
                                VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <StackPanel MinWidth="100">
                            <c:CampoFormulario Etiqueta="Año">
                                <NumericUpDown Value="{Binding FiltroHistorialAnio}"
                                               Minimum="2000" Maximum="2100" FormatString="0" />
                            </c:CampoFormulario>
                        </StackPanel>
                        <StackPanel MinWidth="150">
                            <c:CampoFormulario Etiqueta="Tipo">
                                <ComboBox ItemsSource="{Binding TiposDisponibles}"
                                          SelectedItem="{Binding FiltroHistorialTipoSeleccionado}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nombre}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </c:CampoFormulario>
                        </StackPanel>
                        <StackPanel MinWidth="150">
                            <c:CampoFormulario Etiqueta="Estado">
                                <ComboBox ItemsSource="{Binding EstadosDisponibles}"
                                          SelectedItem="{Binding FiltroHistorialEstadoSeleccionado}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nombre}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </c:CampoFormulario>
                        </StackPanel>
                        <StackPanel MinWidth="240">
                            <c:CampoFormulario Etiqueta="Buscar">
                                <TextBox Text="{Binding FiltroHistorialTexto}"
                                         Watermark="Número, descripción..." />
                            </c:CampoFormulario>
                        </StackPanel>
                        <Button Classes="secondary" Content="Buscar" Command="{Binding BuscarHistorialCommand}" />
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Historial}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentoFila">
                                    <Border Classes="card" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}/{2}">
                                                            <Binding Path="TipoTexto" />
                                                            <Binding Path="Numero" />
                                                            <Binding Path="Anio" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Descripcion}" Classes="caption" />
                                                <TextBlock Text="{Binding EstadoTexto}" Classes="caption" Foreground="{DynamicResource TextoTerciarioBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="ghost" Content="Ver"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).VerDetalleCommand}"
                                                    CommandParameter="{Binding}" />
                                            <!-- I3: "Reabrir…" navega al detalle (VerDetalleCommand), mismo motivo
                                                 que "Anular…" en Activos: reabrir exige motivo obligatorio y ese
                                                 flujo vive en DocumentoFormViewModel.ReabrirAsync. -->
                                            <Button Grid.Column="2" Classes="secondary" Content="Reabrir…"
                                                    IsVisible="{Binding PuedeReabrir}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:DocumentoListViewModel)DataContext).VerDetalleCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
