<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Administracion"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:v2="using:StockApp.Presentation.Controls.V2"
             xmlns:b="using:StockApp.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="StockApp.Presentation.Views.Administracion.MantenimientoView"
             x:DataType="vm:MantenimientoViewModel"
             Classes="ui2"
             Background="{DynamicResource V2FondoBrush}">

    <!-- Mantenimiento (UI v2). Espejo: docs/ui-v2/mockups/administracion/mantenimiento*.html. "Hacer backup ahora" es el único
         primario y vive en el encabezado. Los backups van en una grilla con una columna de acción (Descargar, o Cancelar mientras
         esa fila descarga), que ocupa el alto que dejan las dos cards de abajo (Diagnóstico y Alertas, iguales). La vista también
         la hospeda AccesoLimitadoView cuando la licencia venció, ya con la raíz ui2. -->
    <DockPanel Margin="28,24">

        <v2:EncabezadoPagina x:Name="Encabezado" DockPanel.Dock="Top" Titulo="Mantenimiento"
                             Subtitulo="Backups, diagnóstico y alertas del servidor.">
            <Panel>
                <Button x:Name="BotonBackup" Classes="primario" Content="Hacer backup ahora" Command="{Binding IniciarBackupCommand}"
                        IsVisible="{Binding !IniciandoBackup}" />
                <Button x:Name="BotonIniciando" Classes="primario" Content="Iniciando…" IsEnabled="False"
                        IsVisible="{Binding IniciandoBackup}" />
            </Panel>
        </v2:EncabezadoPagina>

        <v2:GrillaUniformeV2 x:Name="FilaInferior" DockPanel.Dock="Bottom" Columnas="2" Espaciado="16" Margin="0,16,0,0">
            <v2:TarjetaContenido x:Name="CardDiagnostico">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="titulo-seccion" Text="Diagnóstico" Margin="0,0,0,4" />
                    <Panel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button x:Name="BotonDescargarLogs" Classes="secundario" Content="Descargar logs"
                                IsVisible="{Binding !DescargandoLogs}" IsEnabled="{Binding HayLogs}" Command="{Binding DescargarLogsCommand}" />
                        <!-- Señal de progreso: un botón deshabilitado reemplaza al de acción mientras dura la descarga. -->
                        <Button x:Name="BotonDescargandoLogs" Classes="secundario" Content="Descargando…" IsEnabled="False"
                                IsVisible="{Binding DescargandoLogs}" />
                    </Panel>
                    <TextBlock Classes="texto-secundario" Text="{Binding TextoResumenLogs}" TextWrapping="Wrap" />
                </DockPanel>
            </v2:TarjetaContenido>

            <v2:TarjetaContenido x:Name="CardAlertas">
                <StackPanel>
                    <TextBlock Classes="titulo-seccion" Text="Alertas" Margin="0,0,0,4" />
                    <TextBlock Classes="texto-secundario" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Avisá cuando un backup falle o cuando el sistema deje de reportar." />

                    <!-- Sin esto, un GET fallido (p. ej. 423 con la licencia vencida) dejaba la sección en "sin URL / deshabilitado",
                         indistinguible de la verdad, y desde ahí un Guardar apagaba el canal: la alerta explica y bloquea. -->
                    <v2:Alerta x:Name="AlertaErrorAlertas" Variante="Error" Margin="0,0,0,12"
                               Texto="No se pudo cargar la configuración de alertas. Guardar y Probar quedan deshabilitados para no pisar la configuración del servidor."
                               IsVisible="{Binding ErrorAlCargarAlertas}" />

                    <v2:CampoFormulario Etiqueta="URL de webhook (healthchecks.io)" Margin="0,0,0,12">
                        <TextBox x:Name="CajaUrl" Text="{Binding UrlWebhook}" PlaceholderText="https://hc-ping.com/xxxxxxxx"
                                 IsEnabled="{Binding !ErrorAlCargarAlertas}" />
                    </v2:CampoFormulario>

                    <CheckBox x:Name="CasillaHabilitado" Content="Habilitado" IsChecked="{Binding AlertasHabilitadas}"
                              IsEnabled="{Binding !ErrorAlCargarAlertas}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BotonGuardarAlertas" Classes="secundario" Content="Guardar" Command="{Binding GuardarAlertasCommand}"
                                IsEnabled="{Binding PuedeGuardarAlertas}" />
                        <Button x:Name="BotonProbarAlertas" Classes="secundario" Content="Probar" Command="{Binding ProbarAlertasCommand}"
                                IsEnabled="{Binding PuedeProbarAlertas}" />
                    </StackPanel>
                </StackPanel>
            </v2:TarjetaContenido>
        </v2:GrillaUniformeV2>

        <v2:TarjetaContenido x:Name="CardBackups">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="titulo-seccion" Text="Backups" Margin="0,0,0,12" />

                <v2:EstadoCargando x:Name="IndicadorCarga" DockPanel.Dock="Top" Texto="Cargando backups…" IsVisible="{Binding Cargando}" />

                <!-- Error de carga: la Alerta reemplaza al vacío para que no mienta sobre la causa. -->
                <v2:Alerta x:Name="AlertaErrorBackups" DockPanel.Dock="Top" Variante="Error" Texto="No se pudieron cargar los backups."
                           IsVisible="{Binding ErrorAlCargar}" />

                <v2:EstadoVacio x:Name="VacioBackups" DockPanel.Dock="Top" UseLayoutRounding="False"
                                Titulo="Todavía no hay backups registrados." IsVisible="{Binding MostrarListaVacia}" />

                <DataGrid x:Name="GrillaBackups" ItemsSource="{Binding Corridas}" IsReadOnly="True" CanUserSortColumns="True"
                          CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Corridas.Count" Converter="{x:Static conv:ConteoConverter.HayElementos}" />
                            <Binding Path="ErrorAlCargar" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </DataGrid.IsVisible>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FECHA" Width="Auto" SortMemberPath="FinalizadaEn"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.NoCede="True"
                                                b:ColumnaAuto.Conversor="{x:Static conv:FechaHoraLocalConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FilaCorridaBackupVm">
                                    <TextBlock Text="{Binding FinalizadaEn, Converter={x:Static conv:FechaHoraLocalConverter.Instance}}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- RESULTADO: conjunto cerrado (Exitosa o Fallida); el ancho lo pone el título con su flecha de orden, no la insignia. -->
                        <DataGridTemplateColumn Header="RESULTADO" Width="Auto" SortMemberPath="Resultado" b:ColumnaAuto.Medir="True" b:ColumnaAuto.NoCede="True"
                                                b:ColumnaAuto.Ruta="Resultado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FilaCorridaBackupVm">
                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <v2:Insignia Texto="Exitosa" Variante="Exito"
                                                     IsVisible="{Binding Resultado, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Exitosa}" />
                                        <v2:Insignia Texto="Fallida" Variante="Peligro"
                                                     IsVisible="{Binding Resultado, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Fallida}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- DETALLE: el motivo del fallo en peligro; la nota de una fila reconciliada (exitosa) en secundario. -->
                        <DataGridTemplateColumn Header="DETALLE" Width="*" MinWidth="200" SortMemberPath="MotivoFallo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FilaCorridaBackupVm">
                                    <Panel VerticalAlignment="Center">
                                        <TextBlock Classes="negativo" Text="{Binding MotivoFallo}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding MotivoFallo}" b:TooltipSiSeCorta.Activo="True"
                                                   IsVisible="{Binding EsFallo}" />
                                        <TextBlock Text="{Binding MotivoFallo}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding MotivoFallo}" b:TooltipSiSeCorta.Activo="True"
                                                   IsVisible="{Binding EsNotaInformativa}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TAMAÑO" Width="Auto" CellStyleClasses="num" SortMemberPath="TamanioBytes"
                                                b:ColumnaAuto.Medir="True" b:ColumnaAuto.Conversor="{x:Static conv:TamanoLegibleConverter.Instance}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FilaCorridaBackupVm">
                                    <TextBlock Text="{Binding TamanioBytes, Converter={x:Static conv:TamanoLegibleConverter.Instance}}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="116" CanUserSort="False" CellStyleClasses="sin-padding-vertical">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FilaCorridaBackupVm">
                                    <Panel VerticalAlignment="Center">
                                        <!-- Descargar: mientras esta fila NO descarga; deshabilitado sin archivo (las corridas fallidas no tienen). -->
                                        <Button Classes="secundario" Content="Descargar" IsVisible="{Binding !Descargando}"
                                                IsEnabled="{Binding NombreArchivo, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Command="{Binding $parent[UserControl].((vm:MantenimientoViewModel)DataContext).DescargarCommand}"
                                                CommandParameter="{Binding}" />
                                        <!-- Cancelar: solo mientras esta fila puntual descarga (Descargando es por fila). -->
                                        <Button Classes="secundario" Content="Cancelar" IsVisible="{Binding Descargando}"
                                                Command="{Binding $parent[UserControl].((vm:MantenimientoViewModel)DataContext).CancelarCommand}"
                                                CommandParameter="{Binding}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </v2:TarjetaContenido>
    </DockPanel>

</UserControl>
