<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StockApp.Presentation.ViewModels.Administracion"
             xmlns:enums="using:StockApp.Domain.Enums"
             xmlns:conv="using:StockApp.Presentation.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="StockApp.Presentation.Views.Administracion.UsuariosAdminView"
             x:DataType="vm:UsuariosAdminViewModel">

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top"
                   Text="Administración de usuarios"
                   Classes="titulo-vista"
                   Margin="0,0,0,16" />

        <Grid ColumnDefinitions="360,*">

            <!-- Columna izquierda: lista + alta -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="Nuevo usuario" Classes="caption" Opacity="0.6" />
                        <TextBox Watermark="Nombre de usuario" Text="{Binding NuevoNombreUsuario}" />
                        <TextBox Watermark="Nombre completo (opcional)" Text="{Binding NuevoNombreCompleto}" />
                        <TextBox Watermark="Contraseña" PasswordChar="*" Text="{Binding NuevaContrasenaPlan}" />
                        <ComboBox ItemsSource="{Binding RolesDisponibles}"
                                  SelectedItem="{Binding NuevoRol}"
                                  HorizontalAlignment="Stretch" />
                        <Button Classes="primary"
                                Content="Crear usuario"
                                Command="{Binding AltaCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <TextBlock Text="{Binding MensajeError}"
                                   Classes="caption"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding UsuarioSeleccionado}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
                                    <TextBlock Text="{Binding NombreUsuario}"
                                               Opacity="{Binding Activo, Converter={x:Static conv:ActivoOpacidadConverter.Instance}}" />
                                    <TextBlock Text="{Binding Rol}" Classes="caption" Opacity="0.6" />
                                    <Border Classes="badge-inactiva" IsVisible="{Binding !Activo}">
                                        <TextBlock Text="Inactivo" Classes="badge-inactiva-texto" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Columna derecha: acciones del seleccionado + panel de permisos (Task 13) -->
            <Border Grid.Column="1"
                    Classes="card"
                    IsEnabled="{Binding UsuarioSeleccionado, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding UsuarioSeleccionado.NombreUsuario}" Classes="seccion" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="danger" Content="Dar de baja" Command="{Binding BajaCommand}" />
                        <Button Classes="secondary"
                                Content="Hacer Admin"
                                Command="{Binding CambiarRolCommand}"
                                CommandParameter="{x:Static enums:RolUsuario.Admin}"
                                IsVisible="{Binding !EsAdminSeleccionado}" />
                        <Button Classes="secondary"
                                Content="Hacer Operador"
                                Command="{Binding CambiarRolCommand}"
                                CommandParameter="{x:Static enums:RolUsuario.Operador}"
                                IsVisible="{Binding EsAdminSeleccionado}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Watermark="Nueva contraseña"
                                 PasswordChar="*"
                                 Width="220"
                                 Text="{Binding NuevaContrasenaParaSeleccionado}" />
                        <Button Classes="secondary" Content="Cambiar contraseña" Command="{Binding CambiarContrasenaCommand}" />
                    </StackPanel>

                    <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4"
                            DataContext="{Binding PanelPermisos}">
                        <StackPanel Spacing="8" IsEnabled="{Binding !EsAdminSeleccionado}">
                            <TextBlock Text="Acceso total" FontWeight="Bold" Foreground="Gray"
                                       IsVisible="{Binding EsAdminSeleccionado}" />

                            <!-- Catálogo/grupos generados desde CatalogoPermisosPanel (Task 3/4/6):
                                 un checkbox independiente por permiso configurable, sin compuestos. -->
                            <ItemsControl ItemsSource="{Binding Grupos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GrupoPermisos">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Margin="0,8,0,0" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ItemPermiso">
                                                        <CheckBox Content="{Binding Etiqueta}" IsChecked="{Binding Seleccionado}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding MensajeError}"
                                       Foreground="Red"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding MensajeError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <Button Content="Guardar permisos" Command="{Binding GuardarCommand}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
