# Plantilla de secretos para el despliegue de StockApp.Api en el VPS.
#
# Copiá este archivo a "deploy/.env" (NUNCA commitees ese archivo — está en .gitignore) y
# reemplazá TODOS los valores que empiezan con "CAMBIAR". Lo consumen:
#   - deploy/docker-compose.postgres.yml  (POSTGRES_*)
#   - deploy/install.sh                   (todo — genera /etc/stockapp-api/api.env a partir
#                                           de este archivo, con permisos 600)
#
# install.sh se niega a instalar si detecta algún valor que todavía empiece con "CAMBIAR".
#
# IMPORTANTE: generá los secretos con los comandos "openssl rand -base64 ..." indicados en
# cada campo. Si elegís un valor a mano, evitá ";", "#" y saltos de línea — install.sh arma
# con POSTGRES_PASSWORD una connection string separada por ";" (un ";" en el password la
# rompe), y systemd puede tratar un "#" como inicio de comentario en api.env.

# ── Postgres (contenedor stockapp-pg, deploy/docker-compose.postgres.yml) ──────────────
# Usuario de la base de stockapp. "stockapp" está bien salvo que prefieras otro nombre.
POSTGRES_USER=stockapp

# Password de Postgres. GENERAR con:  openssl rand -base64 24
# Ejemplo (NO USAR, es solo para mostrar el formato):
POSTGRES_PASSWORD=CAMBIAR-generar-con-openssl-rand-base64-24

# Nombre de la base de datos.
POSTGRES_DB=stockapp

# ── API ──────────────────────────────────────────────────────────────────────────────
# Interfaz donde escucha la API. install.sh la inyecta en ASPNETCORE_URLS de la unit de
# systemd al instalar/actualizar — no hace falta editar deploy/stockapp-api.service a mano.
#   127.0.0.1 (default) → solo accesible desde el propio VPS; el acceso externo requiere
#     túnel SSH (modo "loopback + túnel" en deploy/DEPLOY.md).
#   0.0.0.0              → accesible directamente desde Internet, SIN túnel (modo "expuesto"
#     en deploy/DEPLOY.md). EXIGE firewall (ufw) configurado ANTES de instalar, y el
#     tráfico va en HTTP PLANO: credenciales de login y JWT viajan sin cifrar.
API_BIND=127.0.0.1

# Puerto donde escucha la API (junto con API_BIND, arriba). install.sh lo inyecta en la
# unit de systemd al instalar/actualizar — no hace falta editar deploy/stockapp-api.service
# a mano si solo cambiás el puerto acá.
API_PORT=5080

# Secreto de firma de los JWT (HS256 — usar al menos 32 caracteres, HMAC-SHA256 los
# necesita). GENERAR con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR-generar-con-openssl-rand-base64-48

# Usuario del Admin inicial. Solo se usa la PRIMERA vez que la API arranca contra una base
# vacía (seed idempotente — con usuarios ya creados, estas dos claves se ignoran).
BOOTSTRAP_ADMIN_USER=admin

# Password del Admin inicial (mínimo 6 caracteres). Cambiala desde el desktop apenas
# actives la licencia y entres por primera vez — este valor solo sirve para el bootstrap.
BOOTSTRAP_PASSWORD=CAMBIAR-elegir-password-admin-inicial

# Clave PÚBLICA de licenciamiento, en Base64 — la mitad pública del par que generás en tu
# máquina (NUNCA en el servidor) con:
#   dotnet run --project tools/StockApp.Licencias.Cli -- generar-claves --salida <dir>
# Pegá acá la línea "Clave pública (pegar en OpcionesLicencia.ClavePublicaBase64Default):"
# que imprime ese comando. La clave PRIVADA (clave-privada.pem) NUNCA va en este archivo,
# NUNCA al servidor y NUNCA al repo — ver deploy/DEPLOY.md, sección de licenciamiento.
LICENCIA_CLAVE_PUBLICA_BASE64=CAMBIAR-pegar-la-clave-publica-base64-generada

# ── Overrides opcionales (passthrough) ──────────────────────────────────────────────────
# Cualquier variable que agregues acá abajo, con la convención de ASP.NET Core (doble
# guión bajo "__" como separador de sección/propiedad), se copia TAL CUAL a
# /etc/stockapp-api/api.env en cada instalación/actualización — sobrevive a corridas
# futuras de install.sh (que de otro modo regenera api.env desde cero con solo las claves
# de arriba). Ejemplo — subir el límite de login (recordá: en modo loopback+túnel, el
# default, todos los clientes entran como 127.0.0.1 y comparten un único balde; en modo
# expuesto (API_BIND=0.0.0.0) el límite se particiona por IP real de cada cliente; default
# 30/60, ver deploy/DEPLOY.md):
#   RateLimiting__Login__PermitLimit=50
#   RateLimiting__Login__WindowSeconds=60
#
# RECOMENDADO si API_BIND=0.0.0.0 (modo expuesto) -- bajar el límite, no subirlo. El
# default en código es 30 intentos/60s (src/StockApp.Api/appsettings.json), calibrado para
# el modo loopback+túnel: ahí TODO el tráfico entra a la API como 127.0.0.1 (el limiter
# particiona por RemoteIpAddress -- ver Program.cs), así que esos 30 son en la práctica un
# balde COMPARTIDO por todos los clientes del túnel juntos. En modo expuesto el limiter sí
# particiona por la IP real de cada uno, así que ese mismo 30 pasa de "techo compartido
# entre todos" a "techo individual por atacante" -- innecesariamente alto, sobre todo
# porque no hay lockout de cuenta: el rate limit por IP es la ÚNICA defensa contra fuerza
# bruta en el login. Bajarlo a 10 no molesta a un usuario legítimo (nadie se equivoca la
# contraseña 10 veces en un minuto):
#   RateLimiting__Login__PermitLimit=10
#   RateLimiting__Login__WindowSeconds=60
#
# PROHIBIDO agregar acá (install.sh se niega a instalar si detecta alguna): ASPNETCORE_*,
# DOTNET_*, LD_*, HOME, PATH. El unit de systemd (stockapp-api.service) ya declara
# ASPNETCORE_URLS y HOME como "Environment=", y EnvironmentFile= (este archivo generado)
# los PISA -- un ASPNETCORE_URLS puesto acá (p.ej. para "cambiar el puerto") saca a la API
# de 127.0.0.1 y, en un VPS sin firewall, la expone a Internet entera sin las advertencias
# ni el firewall que exige el camino soportado. Para cambiar el puerto usá API_PORT y para
# la interfaz usá API_BIND (ambos arriba). Un HOME pisado rompe licencia/backups en
# silencio; un PATH roto tumba pg_dump/pg_isready.
