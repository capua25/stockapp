# Plantilla de secretos para el despliegue de StockApp.Api en el VPS.
#
# Copiá este archivo a "deploy/.env" (NUNCA commitees ese archivo — está en .gitignore) y
# reemplazá TODOS los valores que empiezan con "CAMBIAR". Lo consumen:
#   - deploy/docker-compose.postgres.yml  (POSTGRES_*)
#   - deploy/install.sh                   (todo — genera /etc/stockapp-api/api.env a partir
#                                           de este archivo, con permisos 600)
#
# install.sh se niega a instalar si detecta algún valor que todavía empiece con "CAMBIAR".
#
# IMPORTANTE: generá los secretos con los comandos "openssl rand -base64 ..." indicados en
# cada campo. Si elegís un valor a mano, evitá ";", "#" y saltos de línea — install.sh arma
# con POSTGRES_PASSWORD una connection string separada por ";" (un ";" en el password la
# rompe), y systemd puede tratar un "#" como inicio de comentario en api.env.

# ── Postgres (contenedor stockapp-pg, deploy/docker-compose.postgres.yml) ──────────────
# Usuario de la base de stockapp. "stockapp" está bien salvo que prefieras otro nombre.
POSTGRES_USER=stockapp

# Password de Postgres. GENERAR con:  openssl rand -base64 24
# Ejemplo (NO USAR, es solo para mostrar el formato):
POSTGRES_PASSWORD=CAMBIAR-generar-con-openssl-rand-base64-24

# Nombre de la base de datos.
POSTGRES_DB=stockapp

# ── API ──────────────────────────────────────────────────────────────────────────────
# Puerto donde la API escucha en 127.0.0.1 (nunca 0.0.0.0 — el acceso es por túnel SSH,
# ver deploy/DEPLOY.md). install.sh lo inyecta en la unit de systemd al instalar/actualizar
# — no hace falta editar deploy/stockapp-api.service a mano si solo cambiás el puerto acá.
API_PORT=5080

# Secreto de firma de los JWT (HS256 — usar al menos 32 caracteres, HMAC-SHA256 los
# necesita). GENERAR con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR-generar-con-openssl-rand-base64-48

# Usuario del Admin inicial. Solo se usa la PRIMERA vez que la API arranca contra una base
# vacía (seed idempotente — con usuarios ya creados, estas dos claves se ignoran).
BOOTSTRAP_ADMIN_USER=admin

# Password del Admin inicial (mínimo 6 caracteres). Cambiala desde el desktop apenas
# actives la licencia y entres por primera vez — este valor solo sirve para el bootstrap.
BOOTSTRAP_PASSWORD=CAMBIAR-elegir-password-admin-inicial

# Clave PÚBLICA de licenciamiento, en Base64 — la mitad pública del par que generás en tu
# máquina (NUNCA en el servidor) con:
#   dotnet run --project tools/StockApp.Licencias.Cli -- generar-claves --salida <dir>
# Pegá acá la línea "Clave pública (pegar en OpcionesLicencia.ClavePublicaBase64Default):"
# que imprime ese comando. La clave PRIVADA (clave-privada.pem) NUNCA va en este archivo,
# NUNCA al servidor y NUNCA al repo — ver deploy/DEPLOY.md, sección de licenciamiento.
LICENCIA_CLAVE_PUBLICA_BASE64=CAMBIAR-pegar-la-clave-publica-base64-generada
