<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageVersion Include="Optris.Icons.Avalonia" Version="12.0.7" />
    <PackageVersion Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />

    <!-- Microsoft.* — familia unificada en 10.0.11: última versión estable del canal 10.0.x
         verificada contra el feed de nuget.org (Extensions, EntityFrameworkCore y AspNetCore
         se publican en lockstep). Fija a mano para que ningún wildcard vuelva a resolver
         una combinación inconsistente (ver NU1605 histórico, docs/superpowers/plans/
         2026-07-15-inc7-faseB-licenciamiento-reset.md:758). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <!-- Npgsql.EntityFrameworkCore.PostgreSQL versiona por su cuenta (no lockstep con
         Microsoft.EntityFrameworkCore): 10.0.3 es la última estable disponible y declara
         dependencia [10.0.4, 11.0.0) sobre Microsoft.EntityFrameworkCore, compatible con 10.0.11. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <!-- xunit.runner.visualstudio 2.5.3 es la línea xUnit v2 usada por el resto de la suite.
         StockApp.Presentation.UiTests corre sobre xunit.v3 (paquete de ID distinto) y necesita
         el runner v3-compatible: se override puntual a 3.1.5 en ese csproj, no acá. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />

    <!-- Otros -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
